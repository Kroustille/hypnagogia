class_name BuildCarrier
extends Node
## The build of the player (D9, P5): its StatBlock, its Loadout and its TagTracker, and the one place item effects
## listen to. The player relays its events here; no other story wires a new signal on the player.
## Child of the Player, created by Player._ready().

## A hit is about to be applied: an effect may change info.amount.
signal hit_incoming(info: DamageInfo)
## A hit was applied. lost: half-hearts removed (> 0); source: DamageInfo.Source as an int.
signal hit_taken(lost: int, source: int)
signal dash_ended
## The room has no enemy left. lowest_tier: Lucidity.Tier as an int.
signal room_cleared(room: Node, lowest_tier: int)

var player: Player
## The same object as Player.stats.
var stats: StatBlock
var loadout: Loadout
var tags: TagTracker
## The room the player is in (set by Player.enter_room / leave_room): where synergy effects act. Null between rooms.
var current_room: Room
## Active synergy effects, by synergy id.
var _synergy_effects: Dictionary[StringName, SynergyEffect] = {}
## Synergies already announced (once per synergy and per carrier).
var _announced: Dictionary[StringName, bool] = {}
## acquire() is running: the synergy it reaches is announced after the item banner (a banner replaces the one on screen).
var _acquiring: bool = false
var _to_announce: Array[SynergyDef] = []
## Consumable effects still running (Coffee), by consumable id: one object per definition, reused when it is taken again.
var _running: Dictionary[StringName, ConsumableEffect] = {}

## Placeholder synergy announcement sound (story 5.7), generated by a script; replaced by story 7.7.
const SYNERGY_SOUND: AudioStream = preload("res://audio/sfx/sfx_synergy.wav")

## What using the consumable came to: nothing to use, used, or refused (a sound, nothing spent).
enum UseResult { NONE, USED, REFUSED }


## Dependency injection: call before add_child().
func setup(owner_player: Player, stat_block: StatBlock) -> void:
	player = owner_player
	stats = stat_block
	loadout = Loadout.new(self)
	tags = TagTracker.new(loadout)
	loadout.consumable_changed.connect(_on_consumable_changed)
	loadout.active_changed.connect(_on_active_changed)
	room_cleared.connect(_on_room_cleared_charge)
	tags.synergy_activated.connect(_on_synergy_activated)
	tags.synergy_deactivated.connect(_on_synergy_deactivated)


func _physics_process(delta: float) -> void:
	var ticks: float = GameClock.scale(GameClock.Group.PLAYER)
	var dt: float = delta * ticks
	if dt <= 0.0 or player.health.is_dead():
		return
	for id: StringName in _running.keys():
		var effect: ConsumableEffect = _running[id]
		effect.tick(ticks)
		if effect.is_done():
			_running.erase(id)
	for owned: OwnedItem in loadout.items():
		if owned.effect != null and owned.effect.wants_tick and owned.effect.carrier != null:
			owned.effect.tick(dt)


## Back in the tree (reparented): the effects detached on the way out listen again.
func _enter_tree() -> void:
	if loadout != null:
		loadout.attach_all()
	_attach_synergies()


func _exit_tree() -> void:
	for effect: ConsumableEffect in _running.values():
		effect.cancel()
	_running.clear()
	_detach_synergies()
	if loadout != null:
		loadout.detach_all()


## Why this item cannot be taken now, "" when it can.
func refusal_of(def: ItemDef) -> String:
	if player == null or player.health.is_dead():
		return "dead"
	var problem: String = ItemCatalog.problem_of(def)
	if not problem.is_empty():
		return "invalid definition: %s" % problem
	if not def.stackable and loadout.copies_of(def.id) > 0:
		return "not stackable"
	if def.max_half_hearts_delta < 0 and player.health.max_half_hearts + def.max_half_hearts_delta < Health.MIN_MAX_HALF_HEARTS:
		return "not enough hearts"
	return ""


func can_take(def: ItemDef) -> bool:
	return refusal_of(def).is_empty()


## The player takes a copy of the item: the loadout, the bus and the banner. Null (and a log) when it cannot be taken.
func acquire(def: ItemDef, charge: int = -1) -> OwnedItem:
	var refusal: String = refusal_of(def)
	if not refusal.is_empty():
		Log.warn("items", "item %s refused: %s" % [def.id, refusal])
		return null
	_acquiring = true
	var owned: OwnedItem
	if def.active:
		loadout.set_active(def, charge) # the former active item is the caller's to lay down (Pickup)
		owned = loadout.active
	else:
		owned = loadout.add(def)
	_acquiring = false
	var copies: int = loadout.copies_of(def.id)
	Log.info("items", "item taken %s copies=%d" % [def.id, copies])
	Events.item_acquired.emit(def.id, copies)
	Events.banner_requested.emit(def.name_key, def.bonus_key, def.cost_key)
	_announce_pending()
	return owned


## True when the player can take it: alive, and not the very consumable already carried (an exchange for itself would only
## replay the banner and lay a copy on the floor). Another carried consumable is replaced, not a refusal.
func can_take_consumable(def: ConsumableDef) -> bool:
	return def != null and player != null and not player.health.is_dead() and not (loadout.consumable != null and loadout.consumable.id == def.id)


## The player takes the consumable: the slot, the bus and the banner. Returns the one it replaces (null when the slot was
## free): the caller puts it back on the floor.
func acquire_consumable(def: ConsumableDef) -> ConsumableDef:
	var previous: ConsumableDef = loadout.set_consumable(def)
	Log.info("items", "consumable taken %s replaced=%s" % [def.id, previous.id if previous != null else &"none"])
	Events.banner_requested.emit(def.name_key, def.bonus_key, def.cost_key)
	return previous


## Uses the carried consumable. NONE without one or when dead (silent); REFUSED when its effect says no (nothing is spent).
func use_consumable() -> UseResult:
	var def: ConsumableDef = loadout.consumable
	if def == null or player == null or player.health.is_dead():
		return UseResult.NONE
	var effect: ConsumableEffect = _running.get(def.id)
	if effect == null:
		effect = ConsumableCatalog.make_effect(def)
	if effect == null:
		Log.error("items", "consumable %s has no usable effect" % def.id)
		assert(false, "ConsumableDef.effect_script must extend ConsumableEffect")
		return UseResult.NONE
	if not effect.use(player):
		Log.info("items", "consumable %s refused" % def.id)
		return UseResult.REFUSED
	if not effect.is_done():
		_running[def.id] = effect
	Log.info("items", "consumable used %s" % def.id)
	loadout.set_consumable(null)
	return UseResult.USED


## The effect of a lasting consumable that runs now (checks), null otherwise.
func running_effect(id: StringName) -> ConsumableEffect:
	return _running.get(id)


## Uses the active item. NONE without one; REFUSED when dead, not charged, the gauge is short or the item has no effect:
## nothing is spent then.
func use_active() -> UseResult:
	var owned: OwnedItem = loadout.active
	if owned == null or player == null:
		return UseResult.NONE
	if player.health.is_dead() or owned.effect == null or owned.charge < owned.charge_max:
		return UseResult.REFUSED
	if owned.def.lucidity_cost > 0 and not player.lucidity.try_spend(owned.def.lucidity_cost, owned.def.id):
		return UseResult.REFUSED
	loadout.set_charge(0)
	owned.effect.activate(player)
	Log.info("items", "active item used %s" % owned.def.id)
	return UseResult.USED

## A room was cleared: the active item recharges by one.
func _on_room_cleared_charge(_room: Node, _lowest_tier: int) -> void:
	loadout.add_charge(1)


func _on_active_changed(owned: OwnedItem) -> void:
	if owned == null:
		Events.active_item_changed.emit(&"", 0, 0)
	else:
		Events.active_item_changed.emit(owned.def.id, owned.charge, owned.charge_max)


func _on_consumable_changed(def: ConsumableDef) -> void:
	Events.consumable_changed.emit(def.id if def != null else &"", def.name_key if def != null else &"")


## A synergy level is active: its effect listens, and the first time the synergy is reached it is announced.
func _on_synergy_activated(def: SynergyDef) -> void:
	_attach_synergy(def)
	if _announced.has(def.id):
		return
	_announced[def.id] = true
	_to_announce.append(def)
	if not _acquiring:
		_announce_pending()


func _announce_pending() -> void:
	for def: SynergyDef in _to_announce:
		Log.info("items", "synergy %s announced" % def.id)
		Events.banner_requested.emit(def.name_key, def.description_key, &"")
		Audio.play_sfx(SYNERGY_SOUND, 1)
	_to_announce.clear()


## No announcement when a level ends: its effect is undone and detached.
func _on_synergy_deactivated(def: SynergyDef) -> void:
	var effect: SynergyEffect = _synergy_effects.get(def.id)
	if effect != null:
		effect.detach()
		_synergy_effects.erase(def.id)
	Log.info("items", "synergy %s deactivated" % def.id)


func _attach_synergy(def: SynergyDef) -> void:
	if _synergy_effects.has(def.id):
		return
	var effect: SynergyEffect = SynergyCatalog.make_effect(def)
	if effect == null:
		return
	_synergy_effects[def.id] = effect
	effect.attach(self, def)


## Back in the tree: the active synergies listen again (attach is a no-op when already attached).
func _attach_synergies() -> void:
	for def: SynergyDef in SynergyCatalog.all():
		if tags.active_synergy(def.tag) != def:
			continue
		_attach_synergy(def)
		var effect: SynergyEffect = _synergy_effects.get(def.id)
		if effect != null:
			effect.attach(self, def)


func _detach_synergies() -> void:
	for effect: SynergyEffect in _synergy_effects.values():
		effect.detach()
