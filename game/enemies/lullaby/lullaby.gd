class_name Lullaby
extends ShooterEnemy
## La Berceuse (FR30): keeps between min_distance and max_distance of the player, walking straight toward it when
## farther, straight away from it when closer, still in between. When its fire cycle ends it stops and inhales for
## telegraph_duration (Telegraph: animation and sound), then fires an aimed shot (a volley of bullet_count).
## Contact hurts (Enemy's Hitbox). Every value comes from LullabyDef (lullaby.tres).

enum State { KEEP_DISTANCE, TELEGRAPH }

## Placeholder telegraph sound, generated by a script; replaced by story 7.7.
const TELEGRAPH_SOUND: AudioStream = preload("res://audio/sfx/sfx_enemy_lullaby_telegraph.wav")
## Placeholder sprite canvas in pixels (structural, same as the player). Real sprites come with epic 7.
const SPRITE_SIZE: Vector2i = Vector2i(16, 24)
# Placeholder colors until epic 7: pale water green, distinct from the player (blue), the sleepwalker (violet).
const FILL_COLOR: Color = Color(0.62, 0.85, 0.78)
const MOUTH_COLOR: Color = Color(0.2, 0.3, 0.3)
## Placeholder body, in pixels of the canvas; the inhaling chest is wider by INHALE_GROWTH on each side.
const BODY_RECT: Rect2i = Rect2i(4, 6, 8, 16)
const HEAD_RECT: Rect2i = Rect2i(5, 1, 6, 5)
const INHALE_GROWTH: int = 2
const CHEST_ROWS: int = 6

var _state: State = State.KEEP_DISTANCE
var _lullaby_def: LullabyDef
var _min_px: float = 0.0
var _max_px: float = 0.0
var _speed_px: float = 0.0
var _rest_texture: Texture2D
var _inhale_texture: Texture2D


func _ready() -> void:
	super()
	if _def == null:
		return # already reported by Enemy
	_lullaby_def = _def as LullabyDef
	if _lullaby_def == null:
		process_mode = Node.PROCESS_MODE_DISABLED # before the assert: it aborts the function in debug builds
		Log.error("combat", "lullaby needs a LullabyDef")
		assert(false, "Lullaby needs a LullabyDef")
		return
	# Converted once: tiles to pixels. Invalid values are bounded (AR28).
	_speed_px = _bounded_px(_lullaby_def.move_speed, "move_speed")
	_min_px = _bounded_px(_lullaby_def.min_distance, "min_distance")
	_max_px = _bounded_px(_lullaby_def.max_distance, "max_distance")
	if _min_px >= _max_px:
		# No band: it holds where it is (bounded speed 0), the volley is untouched.
		_speed_px = 0.0
		Log.error("combat", "lullaby min_distance=%s must be below max_distance=%s, it will not move" % [_lullaby_def.min_distance, _lullaby_def.max_distance])
		_assert_failed("LullabyDef min_distance must be below max_distance")
	_rest_texture = _make_texture(false)
	_inhale_texture = _make_texture(true)
	_enter(State.KEEP_DISTANCE)


func _physics_process(_delta: float) -> void:
	var clock_scale: float = GameClock.scale(GameClock.Group.ENEMIES) # one read per tick
	if clock_scale <= 0.0:
		return
	if _tick_dazzle(clock_scale):
		return
	_tick_cycle(clock_scale)
	match _state:
		State.KEEP_DISTANCE:
			_process_keep_distance(clock_scale)
		State.TELEGRAPH:
			_process_telegraph(clock_scale)


func _process_keep_distance(clock_scale: float) -> void:
	if _is_cycle_over():
		_enter(State.TELEGRAPH)
		return
	var distance: float = _distance_to_target()
	if distance > _max_px and is_finite(distance):
		_chase(_target_position(), _speed_px, clock_scale)
	elif distance < _min_px:
		_move_toward(global_position * 2.0 - _target_position(), _speed_px, clock_scale) # straight away
	else:
		velocity = Vector2.ZERO # in the band: holds its position


func _process_telegraph(_clock_scale: float) -> void:
	if not telegraph.is_active():
		_fire_volley()
		_enter(State.KEEP_DISTANCE)


## Dazzled (story 4.4): the telegraph is already cancelled, back to the starting state.
func _on_dazzled() -> void:
	_enter(State.KEEP_DISTANCE)


## The only place that writes _state.
func _enter(next: State) -> void:
	_state = next
	match next:
		State.KEEP_DISTANCE:
			_sprite.texture = _rest_texture
		State.TELEGRAPH:
			velocity = Vector2.ZERO # stands still while inhaling
			_sprite.texture = _inhale_texture
			_start_telegraph(TELEGRAPH_SOUND)


## Tiles (per second) to pixels (per second), bounded to 0 with Log.error + assert when invalid.
func _bounded_px(tiles: float, field: String) -> float:
	var valid: bool = is_finite(tiles) and tiles > 0.0
	var safe: float = tiles * Const.TILE_SIZE if valid else 0.0
	if not valid:
		Log.error("combat", "lullaby %s=%s is invalid, bounded to 0" % [field, tiles])
		_assert_failed("LullabyDef values must be finite and > 0")
	return safe


## Placeholder: a head and a body; inhaling swells the chest by INHALE_GROWTH px each side and opens the mouth.
func _make_texture(inhaling: bool) -> Texture2D:
	var image: Image = Image.create(SPRITE_SIZE.x, SPRITE_SIZE.y, false, Image.FORMAT_RGBA8)
	image.fill_rect(BODY_RECT, FILL_COLOR)
	image.fill_rect(HEAD_RECT, FILL_COLOR)
	if inhaling:
		image.fill_rect(
			Rect2i(BODY_RECT.position.x - INHALE_GROWTH, BODY_RECT.position.y + 1, BODY_RECT.size.x + 2 * INHALE_GROWTH, CHEST_ROWS),
			FILL_COLOR
		)
		image.fill_rect(Rect2i(HEAD_RECT.position.x + 2, HEAD_RECT.end.y - 2, 2, 2), MOUTH_COLOR)
	else:
		image.fill_rect(Rect2i(HEAD_RECT.position.x + 2, HEAD_RECT.end.y - 1, 2, 1), MOUTH_COLOR)
	return ImageTexture.create_from_image(image)
