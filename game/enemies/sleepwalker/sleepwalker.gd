class_name Sleepwalker
extends Enemy
## Le Somnambule (FR27): walks straight at the player, arms out. Within rush_trigger_range it stops and raises its
## arms (Telegraph: animation and sound), then rushes at rush_speed for rush_duration, still steering at the player,
## then walks again. Contact hurts in every state (Enemy's Hitbox). Every value comes from SleepwalkerDef.

enum State { CHASE, TELEGRAPH, RUSH }

## Placeholder telegraph sound, generated by a script; replaced by story 7.7.
const TELEGRAPH_SOUND: AudioStream = preload("res://audio/sfx/sfx_enemy_sleepwalker_telegraph.wav")
const TICK_EPSILON: float = 1e-6
## Placeholder sprite canvas in pixels (structural, same as the player). Real sprites come with epic 7.
const SPRITE_SIZE: Vector2i = Vector2i(16, 24)
# Placeholder colors until epic 7: pale violet, distinct from the player (blue), the targets (orange) and the shots (cyan).
const SPRITE_FILL_COLOR: Color = Color(0.7, 0.55, 0.85)
const SPRITE_RIM_COLOR: Color = Color(0.88, 0.8, 0.97)
## Placeholder body and arms, in pixels of the canvas.
const BODY_RECT: Rect2i = Rect2i(4, 6, 8, 16)
const ARM_LENGTH: int = 5

var _state: State = State.CHASE
var _walk_speed_px: float = 0.0
var _rush_speed_px: float = 0.0
var _trigger_range_px: float = 0.0
var _rush_seconds: float = 0.0
var _rush_ticks_left: float = 0.0
var _sleepwalker_def: SleepwalkerDef
var _walk_texture: Texture2D
var _raise_texture: Texture2D


func _ready() -> void:
	super()
	if _def == null:
		return # already reported by Enemy
	_sleepwalker_def = _def as SleepwalkerDef
	if _sleepwalker_def == null:
		process_mode = Node.PROCESS_MODE_DISABLED # before the assert: it aborts the function in debug builds
		Log.error("combat", "sleepwalker needs a SleepwalkerDef")
		assert(false, "Sleepwalker needs a SleepwalkerDef")
		return
	# Converted once: tiles to pixels. Invalid values are bounded (AR28).
	_walk_speed_px = _bounded_px(_sleepwalker_def.walk_speed, "walk_speed")
	_rush_speed_px = _bounded_px(_sleepwalker_def.rush_speed, "rush_speed")
	_trigger_range_px = _bounded_px(_sleepwalker_def.rush_trigger_range, "rush_trigger_range")
	_rush_seconds = _bounded_seconds(_sleepwalker_def.rush_duration, "rush_duration")
	_walk_texture = _make_texture(false)
	_raise_texture = _make_texture(true)
	_enter(State.CHASE)


func _physics_process(_delta: float) -> void:
	var clock_scale: float = GameClock.scale(GameClock.Group.ENEMIES) # one read per tick
	if clock_scale <= 0.0:
		return
	match _state:
		State.CHASE:
			_process_chase(clock_scale)
		State.TELEGRAPH:
			_process_telegraph(clock_scale)
		State.RUSH:
			_process_rush(clock_scale)


func _process_chase(clock_scale: float) -> void:
	if _distance_to_target() < _trigger_range_px:
		_enter(State.TELEGRAPH)
		return
	_move_toward(_target_position(), _walk_speed_px, clock_scale)


func _process_telegraph(_clock_scale: float) -> void:
	if not telegraph.is_active():
		_enter(State.RUSH)


func _process_rush(clock_scale: float) -> void:
	if _rush_ticks_left <= TICK_EPSILON:
		_enter(State.CHASE)
		return
	_move_toward(_target_position(), _rush_speed_px, clock_scale)
	_rush_ticks_left -= clock_scale


## The only place that writes _state.
func _enter(next: State) -> void:
	_state = next
	match next:
		State.CHASE:
			_sprite.texture = _walk_texture
		State.TELEGRAPH:
			velocity = Vector2.ZERO
			_sprite.texture = _raise_texture
			_start_telegraph_of(_sleepwalker_def.telegraph_duration, TELEGRAPH_SOUND)
		State.RUSH:
			_sprite.texture = _walk_texture
			_rush_ticks_left = _rush_seconds * Engine.physics_ticks_per_second


## Tiles (per second) to pixels (per second), bounded to 0 with Log.error + assert when invalid.
func _bounded_px(tiles: float, field: String) -> float:
	var valid: bool = is_finite(tiles) and tiles > 0.0
	var safe: float = tiles * Const.TILE_SIZE if valid else 0.0
	if not valid:
		Log.error("combat", "sleepwalker %s=%s is invalid, bounded to 0" % [field, tiles])
		_assert_failed("SleepwalkerDef values must be finite and > 0")
	return safe


## Seconds, bounded to 0 (no rush at all) with Log.error + assert when not finite or <= 0.
func _bounded_seconds(seconds: float, field: String) -> float:
	var valid: bool = is_finite(seconds) and seconds > 0.0
	if not valid:
		Log.error("combat", "sleepwalker %s=%s is invalid, bounded to 0" % [field, seconds])
		_assert_failed("SleepwalkerDef durations must be finite and > 0")
	return seconds if valid else 0.0


## Placeholder: body with arms out (horizontal bars at chest height) or raised (vertical bars above the shoulders).
func _make_texture(arms_raised: bool) -> Texture2D:
	var image: Image = Image.create(SPRITE_SIZE.x, SPRITE_SIZE.y, false, Image.FORMAT_RGBA8)
	image.fill_rect(BODY_RECT, SPRITE_FILL_COLOR)
	var chest_y: int = BODY_RECT.position.y + 3
	if arms_raised:
		var shoulder_y: int = BODY_RECT.position.y
		image.fill_rect(Rect2i(BODY_RECT.position.x - 1, shoulder_y - ARM_LENGTH, 1, ARM_LENGTH + 2), SPRITE_RIM_COLOR)
		image.fill_rect(Rect2i(BODY_RECT.end.x, shoulder_y - ARM_LENGTH, 1, ARM_LENGTH + 2), SPRITE_RIM_COLOR)
	else:
		image.fill_rect(Rect2i(0, chest_y, BODY_RECT.position.x, 1), SPRITE_RIM_COLOR)
		image.fill_rect(Rect2i(BODY_RECT.end.x, chest_y, SPRITE_SIZE.x - BODY_RECT.end.x, 1), SPRITE_RIM_COLOR)
	return ImageTexture.create_from_image(image)
