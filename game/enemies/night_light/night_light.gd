class_name NightLight
extends ShooterEnemy
## La Veilleuse (FR28): a turret that never moves. When its fire cycle ends, a glow rises for telegraph_duration
## (Telegraph: animation in GLOW_STEPS textures, and sound), then it fires a fan of bullets centered on the player.
## Contact hurts (Enemy's Hitbox); its body blocks the player but is never pushed (it never calls move_and_slide()).
## Every value comes from its ShooterDef (night_light.tres).

enum State { IDLE, TELEGRAPH }

## Placeholder telegraph sound, generated by a script; replaced by story 7.7.
const TELEGRAPH_SOUND: AudioStream = preload("res://audio/sfx/sfx_enemy_night_light_telegraph.wav")
## Placeholder animation: rest texture plus this many rising glow textures (visual, until epic 7).
const GLOW_STEPS: int = 3
## Placeholder sprite canvas in pixels (structural, same as the player). Real sprites come with epic 7.
const SPRITE_SIZE: Vector2i = Vector2i(16, 24)
# Placeholder colors until epic 7: dull ochre lamp, bulb and halo getting brighter yellow.
const BASE_COLOR: Color = Color(0.62, 0.5, 0.3)
const SHADE_COLOR: Color = Color(0.78, 0.66, 0.42)
const BULB_OFF_COLOR: Color = Color(0.35, 0.3, 0.22)
const BULB_GLOW_COLORS: Array[Color] = [Color(0.85, 0.75, 0.35), Color(0.95, 0.88, 0.45), Color(1.0, 0.97, 0.7)]
const HALO_ALPHAS: Array[float] = [0.25, 0.35, 0.55]
## Placeholder lamp, in pixels of the canvas.
const FOOT_RECT: Rect2i = Rect2i(4, 20, 8, 3)
const STEM_RECT: Rect2i = Rect2i(7, 10, 2, 10)
const SHADE_RECT: Rect2i = Rect2i(3, 4, 10, 6)
const BULB_RECT: Rect2i = Rect2i(6, 10, 4, 3)

var _state: State = State.IDLE
var _rest_texture: Texture2D
var _glow_textures: Array[Texture2D] = []


func _ready() -> void:
	super()
	if _def == null:
		return # already reported by Enemy
	_rest_texture = _make_texture(-1)
	for step: int in GLOW_STEPS:
		_glow_textures.append(_make_texture(step))
	_enter(State.IDLE)


func _physics_process(_delta: float) -> void:
	var clock_scale: float = GameClock.scale(GameClock.Group.ENEMIES) # one read per tick
	if clock_scale <= 0.0:
		return
	_tick_cycle(clock_scale)
	match _state:
		State.IDLE:
			_process_idle(clock_scale)
		State.TELEGRAPH:
			_process_telegraph(clock_scale)


func _process_idle(_clock_scale: float) -> void:
	if _is_cycle_over():
		_enter(State.TELEGRAPH)


func _process_telegraph(_clock_scale: float) -> void:
	if telegraph.is_active():
		_sprite.texture = _glow_textures[mini(int(telegraph.progress() * GLOW_STEPS), GLOW_STEPS - 1)]
		return
	_fire_volley()
	_enter(State.IDLE)


## The only place that writes _state.
func _enter(next: State) -> void:
	_state = next
	match next:
		State.IDLE:
			_sprite.texture = _rest_texture
		State.TELEGRAPH:
			_sprite.texture = _glow_textures[0]
			_start_telegraph(TELEGRAPH_SOUND)


## Placeholder bedside lamp: step -1 is the unlit bulb, 0 to GLOW_STEPS - 1 a brighter bulb and a wider halo.
func _make_texture(step: int) -> Texture2D:
	var image: Image = Image.create(SPRITE_SIZE.x, SPRITE_SIZE.y, false, Image.FORMAT_RGBA8)
	if step >= 0:
		var halo: Color = BULB_GLOW_COLORS[step]
		halo.a = HALO_ALPHAS[step]
		var grow: int = step + 1
		image.fill_rect(Rect2i(SHADE_RECT.position.x - grow, SHADE_RECT.position.y - grow, SHADE_RECT.size.x + 2 * grow, SHADE_RECT.size.y + 2 * grow + 4), halo)
	image.fill_rect(FOOT_RECT, BASE_COLOR)
	image.fill_rect(STEM_RECT, BASE_COLOR)
	image.fill_rect(SHADE_RECT, SHADE_COLOR)
	image.fill_rect(BULB_RECT, BULB_OFF_COLOR if step < 0 else BULB_GLOW_COLORS[step])
	return ImageTexture.create_from_image(image)
