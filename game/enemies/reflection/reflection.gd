class_name Reflection
extends ShooterEnemy
## The hostile reflection of the Mirror (story 5.10, FR52): the player's build turned against them. It carries its own
## BuildCarrier, fed with a copy of the player's ItemDefs (give_build()): its stat modifiers apply (Lead legs slow it,
## the Mirror gives it a rear shot) and only the effects that support a non-player host are attached. It fires through
## the room's enemy BulletManager with the ShotPattern of its own stats, at most as hard as a standard enemy shot.
## Every attack is preceded by a telegraph. Movement, distance, speed and cadence come from ReflectionDef.

enum State { MOVE, TELEGRAPH }

## Placeholder telegraph sound, generated by a script; replaced by story 7.7.
const TELEGRAPH_SOUND: AudioStream = preload("res://audio/sfx/sfx_enemy_lullaby_telegraph.wav")
## Placeholder sprite canvas in pixels (structural, same as the player). Real sprites come with epic 7.
const SPRITE_SIZE: Vector2i = Vector2i(16, 24)
# Placeholder colors until epic 7: the player's silhouette in a cold violet, brighter while it aims.
const FILL_COLOR: Color = Color(0.5, 0.35, 0.7)
const RIM_COLOR: Color = Color(0.75, 0.62, 0.95)
const AIM_COLOR: Color = Color(0.95, 0.85, 1.0)
## Dead band around preferred_distance, in tiles: inside it the reflection holds still (no jitter).
const DISTANCE_BAND_TILES: float = 0.5
## The mirror point is reached within this many pixels.
const MIRROR_REACHED_PX: float = 2.0

## The build of the reflection: its own stats, loadout and carrier (never the player's).
var carrier: BuildCarrier
var stats: StatBlock

var _state: State = State.MOVE
var _reflection_def: ReflectionDef
var _copied_defs: Array[ItemDef] = []
## Center of the room (global): the point MIRROR_PLAYER reflects the player through.
var _mirror_center: Vector2 = Vector2.ZERO
var _rest_texture: Texture2D
var _aim_texture: Texture2D


## Before add_child() (the room's prepare callable): the copy of the player's items, the floor factor of the hit points, and
## the center of the room.
func give_build(defs: Array[ItemDef], factor: float, room_center: Vector2) -> void:
	_copied_defs = defs.duplicate()
	hp_factor = factor
	_mirror_center = room_center


func _ready() -> void:
	super()
	if _def == null:
		return # already reported by Enemy
	_reflection_def = _def as ReflectionDef
	if _reflection_def == null:
		process_mode = Node.PROCESS_MODE_DISABLED # before the assert: it aborts the function in debug builds
		_def = null
		Log.error("combat", "reflection needs a ReflectionDef")
		assert(false, "Reflection needs a ReflectionDef")
		return
	_setup_build()
	_rest_texture = _make_texture(false)
	_aim_texture = _make_texture(true)
	_enter(State.MOVE)


func _physics_process(_delta: float) -> void:
	var clock_scale: float = GameClock.scale(GameClock.Group.ENEMIES) # one read per tick
	if clock_scale <= 0.0:
		return
	if _tick_dazzle(clock_scale):
		return
	_tick_cycle(clock_scale)
	match _state:
		State.MOVE:
			_process_move(clock_scale)
		State.TELEGRAPH:
			_process_telegraph()


## The stats start from the data; the items then add their modifiers. A non-finite speed is bounded to 0 (AR28).
func _setup_build() -> void:
	var speed: float = _reflection_def.move_speed
	if not is_finite(speed) or speed < 0.0:
		Log.error("combat", "reflection move_speed=%s is invalid, bounded to 0" % speed)
		_assert_failed("ReflectionDef move_speed must be finite and >= 0")
		speed = 0.0
	stats = StatBlock.new()
	stats.set_base(StatBlock.Stat.MOVE_SPEED, speed)
	stats.set_base(StatBlock.Stat.REAR_SHOT, 0.0)
	stats.set_bounds(StatBlock.Stat.MOVE_SPEED, 0.0, INF)
	carrier = BuildCarrier.new()
	carrier.name = "BuildCarrier"
	carrier.setup_host(self, stats)
	add_child(carrier)
	for def: ItemDef in _copied_defs:
		carrier.loadout.add_def_for_copy(def)


func _process_move(clock_scale: float) -> void:
	if _is_cycle_over():
		_enter(State.TELEGRAPH)
		return
	var speed_px: float = stats.value_of(StatBlock.Stat.MOVE_SPEED) * Const.TILE_SIZE
	match _reflection_def.movement:
		ReflectionDef.Movement.STILL:
			velocity = Vector2.ZERO
		ReflectionDef.Movement.KEEP_DISTANCE:
			_keep_distance(speed_px, clock_scale)
		ReflectionDef.Movement.MIRROR_PLAYER:
			_go_to_mirror_point(speed_px, clock_scale)


func _keep_distance(speed_px: float, clock_scale: float) -> void:
	var distance: float = _distance_to_target()
	var preferred_px: float = _reflection_def.preferred_distance * Const.TILE_SIZE
	var band_px: float = DISTANCE_BAND_TILES * Const.TILE_SIZE
	if distance > preferred_px + band_px and is_finite(distance):
		_chase(_target_position(), speed_px, clock_scale)
	elif distance < preferred_px - band_px:
		_move_toward(global_position * 2.0 - _target_position(), speed_px, clock_scale) # straight away
	else:
		velocity = Vector2.ZERO


## The point opposite the player through the center of the room.
func _go_to_mirror_point(speed_px: float, clock_scale: float) -> void:
	var point: Vector2 = _mirror_center * 2.0 - _target_position()
	if global_position.distance_to(point) < MIRROR_REACHED_PX or not is_instance_valid(_target):
		velocity = Vector2.ZERO
		return
	_move_toward(point, speed_px, clock_scale)


func _process_telegraph() -> void:
	if not telegraph.is_active():
		_fire_volley()
		_enter(State.MOVE)


## The pattern of its own stats: one shot at the player, and one behind it with the Mirror.
func _volley_directions(aim: Vector2) -> Array[Vector2]:
	return ShotPattern.directions(aim, stats)


## Dazzled (story 4.4): the telegraph is already cancelled, back to the starting state.
func _on_dazzled() -> void:
	_enter(State.MOVE)


## The only place that writes _state.
func _enter(next: State) -> void:
	_state = next
	match next:
		State.MOVE:
			_sprite.texture = _rest_texture
		State.TELEGRAPH:
			velocity = Vector2.ZERO # stands still while aiming
			_sprite.texture = _aim_texture
			_start_telegraph(TELEGRAPH_SOUND)


## Placeholder: the silhouette of the player, with a bright outline while it aims.
func _make_texture(aiming: bool) -> Texture2D:
	var image: Image = Image.create(SPRITE_SIZE.x, SPRITE_SIZE.y, false, Image.FORMAT_RGBA8)
	image.fill_rect(Rect2i(0, 0, SPRITE_SIZE.x, SPRITE_SIZE.y), FILL_COLOR)
	var rim: Color = AIM_COLOR if aiming else RIM_COLOR
	for x: int in SPRITE_SIZE.x:
		image.set_pixel(x, 0, rim)
		image.set_pixel(x, SPRITE_SIZE.y - 1, rim)
	for y: int in SPRITE_SIZE.y:
		image.set_pixel(0, y, rim)
		image.set_pixel(SPRITE_SIZE.x - 1, y, rim)
	return ImageTexture.create_from_image(image)
