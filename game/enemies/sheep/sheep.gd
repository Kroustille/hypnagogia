class_name Sheep
extends Enemy
## Le Mouton (FR29): rests, then scrapes the floor (Telegraph: animation and sound), backs up backup_distance away
## from where the player stood when the scraping began, and charges in a straight line in that direction at
## charge_speed. The charge goes through its target (a collision exception with the target's body, lifted once
## the bodies no longer overlap) and stops on the first thing it hits: a wall (STUNNING_LAYERS) stuns it for
## stun_duration, another enemy only ends the charge. Then it rests again. The direction is set when the scraping
## starts: it never steers (unlike Le Somnambule's rush). Contact hurts in every state (Enemy's Hitbox).
## Every value comes from SheepDef (sheep.tres).

enum State { REST, TELEGRAPH, BACKUP, CHARGE, STUN }

## Placeholder telegraph sound, generated by a script; replaced by story 7.7.
const TELEGRAPH_SOUND: AudioStream = preload("res://audio/sfx/sfx_enemy_sheep_telegraph.wav")
const TICK_EPSILON: float = 1e-6
## What stuns a charging sheep (FR29: walls). Story 4.5 adds the high obstacles.
const STUNNING_LAYERS: int = Const.LAYER_WALLS
## Number of scraping textures, played in order over the telegraph.
const SCRAPE_STEPS: int = 2
## Placeholder sprite canvas in pixels (structural, same as the other enemies). Real sprites come with epic 7.
const SPRITE_SIZE: Vector2i = Vector2i(16, 24)
# Placeholder colors until epic 7: pale wool, distinct from the player (blue), the Sleepwalker (violet), the night
# light (ochre), the lullaby (sea green), the targets (orange) and the shots (cyan).
const WOOL_COLOR: Color = Color(0.93, 0.9, 0.78)
const HEAD_COLOR: Color = Color(0.3, 0.25, 0.25)
const DUST_COLOR: Color = Color(0.7, 0.62, 0.45)
const STAR_COLOR: Color = Color(0.9, 0.8, 0.55)
## Placeholder wool body, in pixels of the canvas.
const WOOL_RECT: Rect2i = Rect2i(3, 8, 10, 10)
const HEAD_RECT: Rect2i = Rect2i(6, 4, 4, 4)

var _state: State = State.REST
var _sheep_def: SheepDef
## True when charge_speed is invalid: it never attacks (a telegraph without an attack would lie to the player).
var _inert: bool = false
var _rest_seconds: float = 0.0
var _backup_px: float = 0.0 # speed, pixels per second
var _backup_seconds: float = 0.0 # backup_distance / backup_speed, 0 when either is invalid
var _charge_px: float = 0.0
var _stun_seconds: float = 0.0
var _ticks_left: float = 0.0 # rest, backup or stun
var _charge_direction: Vector2 = Vector2.ZERO
## The target's body while it is excepted from collisions (from the charge until the bodies no longer overlap).
var _excepted_body: PhysicsBody2D
## Name of what stopped the charge when it was not a wall, for the one log line of the end of a charge.
var _blocker_name: String = ""
var _overlap_query: PhysicsShapeQueryParameters2D
var _rest_texture: Texture2D
var _scrape_textures: Array[Texture2D] = []
var _charge_texture: Texture2D
var _stun_texture: Texture2D


func _ready() -> void:
	super()
	if _def == null:
		return # already reported by Enemy
	_sheep_def = _def as SheepDef
	if _sheep_def == null:
		process_mode = Node.PROCESS_MODE_DISABLED # before the assert: it aborts the function in debug builds
		Log.error("combat", "sheep needs a SheepDef")
		assert(false, "Sheep needs a SheepDef")
		return
	# Converted once: tiles to pixels. Invalid values are bounded (AR28).
	_rest_seconds = _bounded_seconds(_sheep_def.rest_duration, "rest_duration")
	_stun_seconds = _bounded_seconds(_sheep_def.stun_duration, "stun_duration")
	_backup_px = _bounded_px(_sheep_def.backup_speed, "backup_speed")
	var backup_distance_px: float = _bounded_px(_sheep_def.backup_distance, "backup_distance")
	_backup_seconds = backup_distance_px / _backup_px if _backup_px > 0.0 else 0.0
	_charge_px = _bounded_px(_sheep_def.charge_speed, "charge_speed")
	if _charge_px <= 0.0:
		_inert = true
		Log.error("combat", "sheep charge_speed=%s is invalid, it never charges" % _sheep_def.charge_speed)
		_assert_failed("SheepDef.charge_speed must be finite and > 0")
	_overlap_query = PhysicsShapeQueryParameters2D.new()
	_overlap_query.collision_mask = Const.LAYER_PLAYER # the target's layer
	_overlap_query.collide_with_areas = false
	_make_textures()
	_enter(State.REST)


func _physics_process(_delta: float) -> void:
	var clock_scale: float = GameClock.scale(GameClock.Group.ENEMIES) # one read per tick
	if clock_scale <= 0.0:
		return
	if _excepted_body != null and _state != State.CHARGE:
		_release_exception_when_clear()
	match _state:
		State.REST:
			_process_rest(clock_scale)
		State.TELEGRAPH:
			_process_telegraph(clock_scale)
		State.BACKUP:
			_process_backup(clock_scale)
		State.CHARGE:
			_process_charge(clock_scale)
		State.STUN:
			_process_stun(clock_scale)


## No movement and no range condition: the charge crosses the room. Waits (no error) while it has nothing to aim at.
func _process_rest(clock_scale: float) -> void:
	_ticks_left -= clock_scale
	if _ticks_left > TICK_EPSILON or _inert or not is_instance_valid(_target):
		return
	if (_target_position() - global_position).length_squared() < 1e-6:
		return
	_enter(State.TELEGRAPH)


func _process_telegraph(_clock_scale: float) -> void:
	if telegraph.is_active():
		var step: int = mini(int(telegraph.progress() * SCRAPE_STEPS), SCRAPE_STEPS - 1)
		_sprite.texture = _scrape_textures[step]
		return
	_enter(State.BACKUP)


## Slides along a wall (move_and_slide()): neither shortened nor lengthened, it lasts _backup_seconds.
func _process_backup(clock_scale: float) -> void:
	if _ticks_left <= TICK_EPSILON:
		_enter(State.CHARGE)
		return
	_move_in_direction(-_charge_direction, _backup_px, clock_scale)
	_ticks_left -= clock_scale


## The first wall touched stuns; anything else touched only ends the charge. Never slides on (the one slide of the
## tick of the impact, less than a step, is accepted: afterwards it does not move).
func _process_charge(clock_scale: float) -> void:
	_move_in_direction(_charge_direction, _charge_px, clock_scale)
	var count: int = get_slide_collision_count()
	var walled: bool = false
	for i: int in count:
		var collision: KinematicCollision2D = get_slide_collision(i)
		if _is_stunning(collision):
			walled = true
		elif _blocker_name.is_empty():
			var blocker: Node = collision.get_collider() as Node
			_blocker_name = String(blocker.name) if blocker != null else "something"
	if walled:
		_blocker_name = ""
		_enter(State.STUN)
	elif count > 0:
		_enter(State.REST)


## What the collider is by its layer, not its type: independent of tiles (and of rooms/), ready for story 4.5.
## For a tile, get_collider_rid() is the TileMapLayer's quadrant body, which carries the TileSet's layer.
func _is_stunning(collision: KinematicCollision2D) -> bool:
	return (PhysicsServer2D.body_get_collision_layer(collision.get_collider_rid()) & STUNNING_LAYERS) != 0


## Motionless but hittable, its contact is live.
func _process_stun(clock_scale: float) -> void:
	if _ticks_left <= TICK_EPSILON:
		_enter(State.REST)
		return
	_ticks_left -= clock_scale


## The only place that writes _state.
func _enter(next: State) -> void:
	_state = next
	match next:
		State.REST:
			velocity = Vector2.ZERO
			_sprite.texture = _rest_texture
			_ticks_left = _rest_seconds * Engine.physics_ticks_per_second
			if not _blocker_name.is_empty():
				Log.debug("combat", "%s charge stopped by %s" % [name, _blocker_name])
				_blocker_name = ""
		State.TELEGRAPH:
			velocity = Vector2.ZERO
			# Frozen here: a direction, not a point to aim at. Neither the backup nor the charge follow the target.
			_charge_direction = (_target_position() - global_position).normalized()
			_sprite.texture = _scrape_textures[0]
			telegraph.start(_sheep_def.telegraph_duration, TELEGRAPH_SOUND)
		State.BACKUP:
			_sprite.texture = _charge_texture
			_ticks_left = _backup_seconds * Engine.physics_ticks_per_second
		State.CHARGE:
			_sprite.texture = _charge_texture
			var body: PhysicsBody2D = _target as PhysicsBody2D if is_instance_valid(_target) else null
			if is_instance_valid(body) and _excepted_body == null:
				add_collision_exception_with(body)
				_excepted_body = body
		State.STUN:
			velocity = Vector2.ZERO
			_sprite.texture = _stun_texture
			_ticks_left = _stun_seconds * Engine.physics_ticks_per_second
			Log.debug("combat", "%s charge stopped by a wall, stunned" % name)


## Lifts the exception once the bodies no longer overlap: lifting it while they do would make the target be moved
## (or pinned against a wall) by the depenetration of the engine. The query ignores exceptions.
func _release_exception_when_clear() -> void:
	if not is_instance_valid(_excepted_body):
		_excepted_body = null
		return
	_overlap_query.shape = _body.shape
	_overlap_query.transform = _body.global_transform
	_overlap_query.exclude = [get_rid()]
	var results: Array[Dictionary] = get_world_2d().direct_space_state.intersect_shape(_overlap_query, 8)
	for result: Dictionary in results:
		var hit_rid: RID = result["rid"]
		if hit_rid == _excepted_body.get_rid():
			return
	remove_collision_exception_with(_excepted_body)
	_excepted_body = null


## Tiles (per second) to pixels (per second), bounded to 0 with Log.error + assert when invalid.
func _bounded_px(tiles: float, field: String) -> float:
	var valid: bool = is_finite(tiles) and tiles > 0.0
	if not valid and field != "charge_speed": # an invalid charge_speed has its own message
		Log.error("combat", "sheep %s=%s is invalid, bounded to 0" % [field, tiles])
		_assert_failed("SheepDef values must be finite and > 0")
	return tiles * Const.TILE_SIZE if valid else 0.0


## Seconds, bounded to 0 with Log.error + assert when not finite or <= 0.
func _bounded_seconds(seconds: float, field: String) -> float:
	var valid: bool = is_finite(seconds) and seconds > 0.0
	if not valid:
		Log.error("combat", "sheep %s=%s is invalid, bounded to 0" % [field, seconds])
		_assert_failed("SheepDef durations must be finite and > 0")
	return seconds if valid else 0.0


func _make_textures() -> void:
	_rest_texture = _make_texture(&"rest")
	_scrape_textures = [_make_texture(&"scrape_up"), _make_texture(&"scrape_down")]
	_charge_texture = _make_texture(&"charge")
	_stun_texture = _make_texture(&"stun")


## Placeholder: a ball of wool with a dark head and two legs. Poses: a raised foreleg, then planted in a dust cloud
## (scraping), head down and body low (charging), crossed eyes and stars (stunned).
func _make_texture(pose: StringName) -> Texture2D:
	var image: Image = Image.create(SPRITE_SIZE.x, SPRITE_SIZE.y, false, Image.FORMAT_RGBA8)
	var wool: Rect2i = WOOL_RECT
	var head: Rect2i = HEAD_RECT
	if pose == &"charge":
		wool = Rect2i(3, 11, 10, 8) # lower body
		head = Rect2i(5, 9, 6, 4) # head down, in front of the body
	image.fill_rect(wool, WOOL_COLOR)
	image.fill_rect(head, HEAD_COLOR)
	image.fill_rect(Rect2i(9, wool.end.y, 2, 3), HEAD_COLOR) # hind leg
	match pose:
		&"scrape_up":
			image.fill_rect(Rect2i(1, wool.end.y - 4, 3, 2), HEAD_COLOR) # foreleg raised
		&"scrape_down":
			image.fill_rect(Rect2i(4, wool.end.y, 2, 3), HEAD_COLOR) # foreleg planted
			image.fill_rect(Rect2i(0, wool.end.y + 3, 4, 2), DUST_COLOR)
			image.fill_rect(Rect2i(12, wool.end.y + 3, 3, 2), DUST_COLOR)
		&"stun":
			image.fill_rect(Rect2i(4, wool.end.y, 2, 3), HEAD_COLOR)
			image.fill_rect(Rect2i(6, 5, 1, 1), WOOL_COLOR) # crossed eyes
			image.fill_rect(Rect2i(9, 5, 1, 1), WOOL_COLOR)
			image.fill_rect(Rect2i(7, 6, 2, 1), WOOL_COLOR)
			for star_x: int in [2, 7, 12]:
				image.fill_rect(Rect2i(star_x, 1, 2, 2), STAR_COLOR)
		_:
			image.fill_rect(Rect2i(4, wool.end.y, 2, 3), HEAD_COLOR)
	return ImageTexture.create_from_image(image)
