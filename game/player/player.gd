class_name Player
extends CharacterBody2D
## The player. Node origin = center of the torso: shots start from there.
## Movement, aim and shots read the InputMap in _physics_process and obey GameClock.
## Shots need a BulletManager given by the room through equip_bullets().

## Emitted when a dash finishes, after its last movement.
signal dash_ended
## Awakening was paid and fired: the room clears its bullets and pushes enemies. origin: global position of the player.
signal awakening_used(origin: Vector2)
## Glide was paid and done: the room shows its rings. from and to: global positions (departure and arrival).
signal glided(from: Vector2, to: Vector2)
## Emitted once, when the player dies: after the Events.player_hit of the lethal hit.
## The Run is its only listener: it emits Events.run_ended inside this emission, so any other listener of died
## runs after run_ended and after Main froze the game; cross-system listeners use Events.run_ended.
signal died

## Placeholder sprite size in pixels (structural, not gameplay). Real sprites come with epic 7.
const SPRITE_SIZE: Vector2i = Vector2i(16, 24)
# Placeholder colors until epic 7.
const SPRITE_FILL_COLOR: Color = Color(0.45, 0.65, 0.95)
const SPRITE_RIM_COLOR: Color = Color(0.75, 0.88, 1.0)
# Placeholder tint while the dash makes the player invulnerable, until epic 7.
const DASH_TINT: Color = Color(1.0, 1.0, 1.0, 0.5)
## Placeholder shot texture, same size as the 4x4 px hitbox (enemy placeholder bullets are 8x8), until story 7.2.
const SHOT_TEXTURE_SIZE: int = 4
## Placeholder shot opacity: more transparent than enemy bullets (NFR8), until story 7.2.
const SHOT_ALPHA: float = 0.7
## Placeholder shot sound, generated by a script; replaced by story 7.7.
const SHOT_SOUND: AudioStream = preload("res://audio/sfx/sfx_player_shot.wav")

## Placeholder hit sound, generated by a script; replaced by story 7.7.
const HIT_SOUND: AudioStream = preload("res://audio/sfx/sfx_player_hit.wav")
## Placeholder tier sounds (story 3.1), generated by a script; replaced by story 7.7.
const TIER_DOWN_SOUND: AudioStream = preload("res://audio/sfx/sfx_lucidity_tier_down.wav")
const TIER_UP_SOUND: AudioStream = preload("res://audio/sfx/sfx_lucidity_tier_up.wav")
## Placeholder graze and perfect dash sounds (story 3.2), generated by a script; replaced by story 7.7.
const GRAZE_SOUND: AudioStream = preload("res://audio/sfx/sfx_graze.wav")
const PERFECT_DASH_SOUND: AudioStream = preload("res://audio/sfx/sfx_perfect_dash.wav")
## Placeholder Awakening and refusal sounds (story 3.3), generated by a script; replaced by story 7.7.
const AWAKENING_SOUND: AudioStream = preload("res://audio/sfx/sfx_awakening.wav")
const POWER_REFUSED_SOUND: AudioStream = preload("res://audio/sfx/sfx_power_refused.wav")
## Placeholder Glide sound (story 3.4), generated by a script; replaced by story 7.7.
const GLIDE_SOUND: AudioStream = preload("res://audio/sfx/sfx_glide.wav")
## A wall of bullets must not saturate the audio: graze voices at once.
const GRAZE_MAX_VOICES: int = 2
## Half period of the blink after a hit, in game ticks (0.1 s at 60 Hz). Visual placeholder until epic 7: small
## surface, no full-screen flash (photosensitivity settings: FR67, epic 3).
const BLINK_HALF_PERIOD_TICKS: int = 6
## Margin against floating point rounding when comparing the arrival ticks left to zero.
const ARRIVAL_EPSILON: float = 1e-6
## Bounds of the stats (story 5.1). Shot speed: a shot may not cross a whole tile in one tick (BulletManager refuses it): below
## the physics rate in tiles per second. Hurtbox: the smallest the tuning allows. Move speed and fire rate: still playable.
const MIN_SHOT_SPEED: float = 0.5
const MAX_SHOT_SPEED: float = 59.0
const MIN_HURTBOX_SIZE: float = 0.0625
const MIN_MOVE_SPEED: float = 1.0
const MIN_FIRE_RATE: float = 0.5
## Damage never reaches 0: BulletManager refuses a shot that does no damage.
const MIN_DAMAGE: float = 0.1

## Hearts, armor and invulnerability after a hit. Created in code (setup() before add_child()).
var health: Health
## The lucidity gauge (story 3.1), full at the start of a run. Created in code like health.
var lucidity: Lucidity
## The zone enemy bullets hit. The room registers it with the enemy BulletManager.
var hurtbox: Hurtbox
## Damage, shot speed and hurtbox size with their modifiers (D9). Lucidity tiers write their modifiers here.
var stats: StatBlock
## The build: items, tags and the place effects listen to (story 5.1). Shares `stats`.
var carrier: BuildCarrier

var _motor: PlayerMotor
## Last safe position and fall decision (story 4.3). Replaced by enter_room().
var _pit_guard: PitGuard = PitGuard.new()
## The room that answers "is there a pit here"; null outside a room (no fall then).
var _room: Room
var _dash: Dash
## Recharge of Awakening (power_1), in game ticks of the player group.
var _awakening_cooldown: PowerCooldown = PowerCooldown.new()
## Recharge of Glide (power_2), in game ticks of the player group.
var _glide_cooldown: PowerCooldown = PowerCooldown.new()
## Ticks of arrival invulnerability left after a Glide (ordinary invulnerability: no graze, no perfect dash).
var _arrival_ticks_left: float = 0.0
## Last movement direction (unit vector). The character faces the camera until the player first moves.
var _facing: Vector2 = Vector2.DOWN
var _aim: Aim
var _shooter: Shooter
var _recoil: SpriteKick
var _bullets: BulletManager
## Own copy built once from Tuning.SHOT by equip_bullets(), never a shared Resource.
var _shot_params: BulletParams
## The hurtbox own rectangle, resized when the HURTBOX_SIZE stat changes.
var _hurtbox_shape: RectangleShape2D
## Viewport mouse position on the previous tick: the mouse takes the aim back only when it moves.
var _last_mouse_pos: Vector2 = Vector2.ZERO
var _unequipped_reported: bool = false
var _death_handled: bool = false
## Last tier put on the bus (the tier before a change).
var _announced_tier: int = 0
## True while the sprite blinks after a hit: visible is written on blink transitions only.
var _blinking: bool = false

@onready var _sprite: Sprite2D = %Sprite
@onready var _hitbox: CollisionShape2D = %Hitbox


func _ready() -> void:
	motion_mode = CharacterBody2D.MOTION_MODE_FLOATING
	collision_layer = Const.LAYER_PLAYER
	collision_mask = Const.LAYER_WALLS | Const.LAYER_ENEMIES | Const.LAYER_HIGH_OBSTACLES | Const.LAYER_LOW_OBSTACLES | Const.LAYER_FURNITURE # the dash and the walk stop on enemy bodies (FR4), obstacles and furniture
	_motor = PlayerMotor.new(Tuning.PLAYER)
	_dash = Dash.new(Tuning.DASH)
	_dash.ended.connect(_on_dash_ended)

	_sprite.centered = true
	_sprite.offset = Vector2.ZERO
	_sprite.texture = _make_sprite_texture()

	# A fresh shape per instance: never modify a sub-resource shared by the scene.
	var shape: RectangleShape2D = RectangleShape2D.new()
	shape.size = Vector2.ONE * Tuning.PLAYER.hitbox_size * Const.TILE_SIZE
	_hitbox.shape = shape
	_hitbox.position = Vector2.ZERO
	_hitbox.add_to_group(Const.GROUP_DEBUG_SHAPES)

	_setup_health()
	_setup_lucidity()
	_setup_stats()
	_setup_carrier()
	Events.room_cleared.connect(_on_room_cleared)

	_aim = Aim.new()
	_shooter = Shooter.new(Tuning.SHOT)
	_shooter.set_fire_rate(stats.value_of(StatBlock.Stat.FIRE_RATE))
	_recoil = SpriteKick.new(_sprite)
	_last_mouse_pos = get_viewport().get_mouse_position()
	var reticle: Reticle = Reticle.new()
	reticle.setup(self)
	add_child(reticle)


func _setup_health() -> void:
	add_to_group(Const.GROUP_PLAYER)
	health = Health.new()
	health.name = "Health"
	var combat: CombatTuning = Tuning.COMBAT
	health.setup(
		combat.starting_half_hearts,
		combat.heart_cap_half_hearts,
		combat.hit_invulnerability_duration,
		GameClock.Group.PLAYER
	)
	add_child(health)
	health.changed.connect(_on_health_changed)
	_on_health_changed() # initial state for the HUD

	hurtbox = Hurtbox.new()
	hurtbox.name = "Hurtbox"
	hurtbox.camp = BulletManager.Camp.PLAYER
	hurtbox.one_hit_per_tick = true
	var shape_node: CollisionShape2D = CollisionShape2D.new()
	shape_node.name = "Shape"
	var shape: RectangleShape2D = RectangleShape2D.new()
	shape.size = Vector2.ONE * Tuning.PLAYER.hitbox_size * Const.TILE_SIZE
	_hurtbox_shape = shape
	shape_node.shape = shape
	hurtbox.add_child(shape_node) # before add_child(hurtbox): its _ready() looks for the shape
	add_child(hurtbox)
	hurtbox.set_hit_filter(_can_be_hit)
	hurtbox.set_evade_filter(_is_evading)
	hurtbox.damage_received.connect(_on_hurtbox_damage_received)


## Called by the room once it has built its BulletManager (the player is already ready by then). Repeatable: the same
## manager again changes nothing; a manager that is gone or about to be freed is refused. A new manager gets its own
## shot appearance (the previous one belonged to the manager of the room left).
func equip_bullets(manager: BulletManager) -> void:
	if manager == null or not is_instance_valid(manager) or manager.is_queued_for_deletion():
		Log.error("combat", "equip_bullets() called without a usable BulletManager")
		assert(false, "equip_bullets() needs a BulletManager")
		return
	if manager == _bullets:
		return
	var tuning: ShotTuning = Tuning.SHOT
	_bullets = manager
	_unequipped_reported = false
	_shot_params = BulletParams.new()
	_shot_params.speed = stats.value_of(StatBlock.Stat.SHOT_SPEED)
	_shot_params.radius = maxf(tuning.hitbox_size, 0.0) / 2.0
	_shot_params.lifetime = tuning.lifetime
	_shot_params.damage = stats.value_of(StatBlock.Stat.DAMAGE)
	_shot_params.pierce = stats.value_of(StatBlock.Stat.PIERCE) > 0.0
	_shot_params.appearance = manager.add_appearance(_make_shot_texture())


## Called by the room once ready: from now on the player reads its pits and floor. The last safe position starts over.
func enter_room(room: Room) -> void:
	_room = room
	if carrier != null:
		carrier.current_room = room
	_pit_guard = PitGuard.new()
	# The spawn cell is the first safe position: a first tick ending in a pit still falls (Run places the player there).
	var spawn: Vector2 = room.player_spawn_position()
	_pit_guard.observe(room.cell_center_at(spawn), room.is_floor_at(spawn) and not room.is_pit_at(spawn))


## The room goes away: the player forgets everything it gave (pit test, shots). Ignored when another room has become
## current since (the next one may enter first).
func leave_room(room: Room) -> void:
	if _room == room:
		_room = null
		if carrier != null and carrier.current_room == room:
			carrier.current_room = null
	if _bullets != null and (not is_instance_valid(_bullets) or room.is_ancestor_of(_bullets)):
		_bullets = null
		_shot_params = null


## Turns the character toward a direction (the room entered by a door: face the inside).
func face(direction: Vector2) -> void:
	if direction != Vector2.ZERO:
		_facing = direction.normalized()


## Stops the walk and a dash in flight (the player is placed somewhere else: a room entered by a door).
func stop_motion() -> void:
	_dash.cancel()
	_motor.reset()
	velocity = Vector2.ZERO


func _physics_process(delta: float) -> void:
	var clock_scale: float = GameClock.scale(GameClock.Group.PLAYER)
	var wish: Vector2 = Input.get_vector(&"move_left", &"move_right", &"move_up", &"move_down")
	if wish != Vector2.ZERO:
		_facing = wish.normalized()
	# The motor runs on the real delta so the ramps and the paused state stay consistent with the input;
	# it keeps stepping during a dash so walking resumes smoothly when the dash ends.
	_motor.step(wish, delta)
	_dash.tick(clock_scale, Input.is_action_just_pressed(&"dash"), _facing)
	_update_consumable_input(clock_scale)
	_update_active_input(clock_scale)
	_update_powers(clock_scale)
	_update_shooting(clock_scale) # before the movement: sees "is the dash active this tick"
	# velocity is rewritten every tick: move_and_slide() alters it when sliding, never read it back.
	if _dash.is_active():
		# Already scaled by the clock inside Dash: do not multiply by clock_scale again.
		velocity = _dash.velocity(delta)
	else:
		# The clock scale is applied once, on the final velocity (move_and_slide() uses the unscaled delta).
		velocity = _motor.velocity * clock_scale # read after the powers: a fall in this tick zeroed it
	move_and_slide()
	_dash.finish_tick()  # after the movement: listeners of dash_ended see the final position
	if not _dash.is_active():
		_check_pits() # walking, or the tick the dash ended: a dash in flight never tests a cell
	_update_dash_tint()
	_update_blink()


## The consumable (story 5.3): used on the press, silent without one; a refusal plays the refusal sound only.
func _update_consumable_input(clock_scale: float) -> void:
	if clock_scale > 0.0 and Input.is_action_just_pressed(&"use_consumable"):
		if carrier.use_consumable() == BuildCarrier.UseResult.REFUSED:
			Audio.play_sfx(POWER_REFUSED_SOUND, 1)


## The active item (story 5.8): used on the press, silent without one; a refusal plays the refusal sound only.
func _update_active_input(clock_scale: float) -> void:
	if clock_scale > 0.0 and Input.is_action_just_pressed(&"use_active"):
		if carrier.use_active() == BuildCarrier.UseResult.REFUSED:
			Audio.play_sfx(POWER_REFUSED_SOUND, 1)


## Powers, read after the dash and before the movement.
func _update_powers(clock_scale: float) -> void:
	_awakening_cooldown.tick(clock_scale)
	if clock_scale > 0.0 and Input.is_action_just_pressed(&"power_1"):
		_try_awakening()
	_glide_cooldown.tick(clock_scale)
	_arrival_ticks_left = maxf(_arrival_ticks_left - clock_scale, 0.0)
	if clock_scale > 0.0 and Input.is_action_just_pressed(&"power_2"):
		_try_glide()


## Pays for Awakening and announces it; a refusal (gauge, recharge) only plays a sound and starts nothing.
func _try_awakening() -> void:
	var tuning: AwakeningTuning = Tuning.AWAKENING
	if health.is_dead() or not _awakening_cooldown.is_ready() or not lucidity.try_spend(tuning.cost, &"awakening"):
		Audio.play_sfx(POWER_REFUSED_SOUND, 1)
		return
	_awakening_cooldown.start(tuning.cooldown)
	Audio.play_sfx(AWAKENING_SOUND, 1)
	awakening_used.emit(global_position)


## Teleports toward the aimed point (at most max_distance tiles), through bullets and low obstacles. A refusal
## (dead, gauge, recharge, trip too short) only plays a sound and spends nothing.
func _try_glide() -> void:
	var tuning: GlideTuning = Tuning.GLIDE
	if health.is_dead() or not _glide_cooldown.is_ready():
		Audio.play_sfx(POWER_REFUSED_SOUND, 1)
		return
	var stick: Vector2 = Input.get_vector(&"aim_left", &"aim_right", &"aim_up", &"aim_down")
	var from_stick: bool = stick != Vector2.ZERO or _aim.source == Aim.Source.STICK
	var cursor_offset: Vector2 = get_global_mouse_position() - global_position
	var dir: Vector2 = _aim.direction
	if stick != Vector2.ZERO:
		dir = stick.normalized()
	elif not from_stick and cursor_offset.length_squared() > Aim.MIN_CURSOR_DISTANCE_SQ:
		dir = cursor_offset.normalized()
	var distance: float = Glide.distance_for(tuning, from_stick, stick, cursor_offset)
	var destination: Vector2 = Glide.resolve_destination(
		get_world_2d().direct_space_state, global_position, dir, distance, _hitbox.shape, [get_rid()]
	)
	var too_short: bool = global_position.distance_to(destination) < tuning.min_travel * Const.TILE_SIZE
	if too_short or not lucidity.try_spend(tuning.cost, &"glide"):
		Audio.play_sfx(POWER_REFUSED_SOUND, 1)
		return
	var from: Vector2 = global_position
	global_position = destination
	reset_physics_interpolation() # the sprite (and the reticle) must not cross the screen in one tick
	if _room != null:
		_room.snap_camera()
	_glide_cooldown.start(tuning.cooldown)
	# Landing in a pit: no arrival invulnerability, it would refuse the fall hit (story 4.3).
	var falls: bool = _is_over_pit()
	_arrival_ticks_left = 0.0 if falls else tuning.arrival_invulnerability * Engine.physics_ticks_per_second
	Audio.play_sfx(GLIDE_SOUND, 1)
	glided.emit(from, destination)
	if falls:
		_fall()


## True when the player can fly over pits (stat CAN_FLY_OVER_PITS > 0).
func can_fly_over_pits() -> bool:
	return stats.value_of(StatBlock.Stat.CAN_FLY_OVER_PITS) > 0.0


## True when the center of the body is in a pit the player would fall into: a room, no flight, a safe place to return to.
func _is_over_pit() -> bool:
	if _room == null or health.is_dead() or can_fly_over_pits():
		return false
	return _pit_guard.should_fall(global_position, _room.is_pit_at(global_position))


## The flight just went away: a player over a pit falls back to the last safe cell, without the fall hit (the hit that
## took the flight was the only one). True when it fell.
func fall_if_over_pit() -> bool:
	if not _is_over_pit():
		return false
	_fall(false)
	return true


## Remembers the safe position, or falls. After the movement of the tick (never from a physics callback).
func _check_pits() -> void:
	if _room == null or health.is_dead():
		return
	var on_floor: bool = _room.is_floor_at(global_position)
	var safe: bool = on_floor and not _room.is_pit_at(global_position) # flight only removes the fall, never a pit as a safe place
	_pit_guard.observe(_room.cell_center_at(global_position), safe)
	if _is_over_pit():
		_fall()


## The one way to fall: back to the last safe position (the center of its cell) first, then the hit. The hit goes
## through the hurtbox like any other, so an invulnerable player is returned without damage.
func _fall(deal_damage: bool = true) -> void:
	var from: Vector2 = global_position
	global_position = _pit_guard.last_safe
	velocity = Vector2.ZERO
	_motor.reset() # else the motor rewrites the velocity next tick and the player walks back into the pit
	reset_physics_interpolation()
	if _room != null:
		_room.snap_camera()
	var amount: int = roundi(stats.value_of(StatBlock.Stat.PIT_DAMAGE))
	Log.debug("combat", "player fell at %s, back to %s damage=%d" % [from, global_position, amount])
	if amount < 1 or not deal_damage:
		return
	var info: DamageInfo = DamageInfo.new()
	info.amount = amount
	info.source = DamageInfo.Source.PIT
	hurtbox.receive(info)


## Awakening recharge, 0 just after use, 1 when ready (debug overlay).
func awakening_cooldown_progress() -> float:
	return _awakening_cooldown.progress()


## Glide recharge, 0 just after use, 1 when ready (debug overlay).
func glide_cooldown_progress() -> float:
	return _glide_cooldown.progress()


func is_dash_invulnerable() -> bool:
	return _dash.is_invulnerable()


## Dash, Glide arrival or post-hit (or forced, debug) invulnerability.
func is_invulnerable() -> bool:
	return is_dash_invulnerable() or is_arrival_invulnerable() or health.is_invulnerable()


## The few ticks after a Glide.
func is_arrival_invulnerable() -> bool:
	return _arrival_ticks_left > ARRIVAL_EPSILON


func is_dashing() -> bool:
	return _dash.is_active()


## Current aim direction (unit vector, never zero).
func aim_direction() -> Vector2:
	return _aim.direction


func aim_source() -> Aim.Source:
	return _aim.source


func _update_shooting(clock_scale: float) -> void:
	var stick: Vector2 = Input.get_vector(&"aim_left", &"aim_right", &"aim_up", &"aim_down")
	var mouse_pos: Vector2 = get_viewport().get_mouse_position()
	var mouse_moved: bool = mouse_pos != _last_mouse_pos
	_last_mouse_pos = mouse_pos
	_aim.update(global_position, get_global_mouse_position(), mouse_moved, stick)
	# Click or RT (shoot), or the right stick beyond its dead zone (auto fire).
	var wants_fire: bool = Input.is_action_pressed(&"shoot") or _aim.is_stick_active()
	# Before the shot: a recoil started on this tick keeps all its ticks (0.05 s = 3 rendered ticks).
	_recoil.tick(clock_scale)
	if _shooter.tick(clock_scale, wants_fire, _dash.is_active()):
		_fire()


## One shot from the center of the torso, exactly along the aim. No recoil or sound if the pool refuses it.
func _fire() -> void:
	if _bullets == null:
		if not _unequipped_reported:
			_unequipped_reported = true
			Log.error("combat", "player cannot shoot: no BulletManager (equip_bullets() not called)")
		return
	if not _bullets.fire(_shot_params, _bullets.to_local(global_position), _aim.direction):
		return
	var tuning: ShotTuning = Tuning.SHOT
	_recoil.kick(-_aim.direction, tuning.recoil_distance * Const.TILE_SIZE, tuning.recoil_duration)
	Audio.play_sfx(SHOT_SOUND)


func _update_dash_tint() -> void:
	_sprite.modulate = DASH_TINT if is_dash_invulnerable() or is_arrival_invulnerable() else Color.WHITE


## Evade filter: only the dash of a player who could otherwise be hit pays a perfect dash.
func _is_evading() -> bool:
	return is_dash_invulnerable() and not health.is_invulnerable() and not health.is_dead()


## Hit filter of the hurtbox: bullets pass through while invulnerable or dead.
func _can_be_hit() -> bool:
	return not is_invulnerable() and not health.is_dead()


## Builds the gauge and relays it on the bus: value for the HUD, tier change for sound and telemetry.
func _setup_lucidity() -> void:
	lucidity = Lucidity.new(Tuning.LUCIDITY)
	lucidity.value_changed.connect(_on_lucidity_value_changed)
	lucidity.tier_changed.connect(_on_lucidity_tier_changed)
	lucidity.spent.connect(_on_lucidity_spent)
	lucidity.room_danger_raised.connect(_on_lucidity_room_danger_raised)
	_announced_tier = lucidity.live_tier
	_on_lucidity_value_changed(lucidity.value) # initial state for the HUD


## A bullet passed close to the hurtbox without touching it (signal of the enemy BulletManager, story 3.2).
func on_bullet_grazed(bullet_position: Vector2) -> void:
	if health.is_dead():
		return
	var gained: int = lucidity.gain(Tuning.LUCIDITY.graze_gain, Lucidity.Source.GRAZE)
	Events.player_grazed.emit(bullet_position, gained)
	Audio.play_sfx(GRAZE_SOUND, GRAZE_MAX_VOICES)
	Log.debug("lucidity", "graze +%d value=%d" % [gained, lucidity.value])


## The dash invulnerability avoided a bullet that would have hit (once per bullet).
func on_bullet_dodged(bullet_position: Vector2) -> void:
	if health.is_dead():
		return
	var gained: int = lucidity.gain(Tuning.LUCIDITY.perfect_dash_gain, Lucidity.Source.PERFECT_DASH)
	Events.perfect_dash.emit(bullet_position, gained)
	Audio.play_sfx(PERFECT_DASH_SOUND, 1)
	Log.debug("lucidity", "perfect dash +%d value=%d" % [gained, lucidity.value])


## The room has no enemy left: a living player gains lucidity.
func _on_room_cleared(room: Node, lowest_tier: int) -> void:
	if health.is_dead():
		return
	carrier.room_cleared.emit(room, lowest_tier)
	lucidity.gain(Tuning.LUCIDITY.room_cleared_gain, Lucidity.Source.ROOM_CLEARED)


## Tells the HUD (through the bus: the Run, so the player, is recreated every run).
func _on_health_changed() -> void:
	Events.player_health_changed.emit(health.half_hearts, health.max_half_hearts, health.armor)


func _on_lucidity_value_changed(value: int) -> void:
	Events.lucidity_value_changed.emit(value, lucidity.live_tier)


## Announces a tier change on the bus and by sound (a lower tone down, a rising one up).
func _on_lucidity_tier_changed(tier: Lucidity.Tier) -> void:
	_apply_tier_modifiers(tier) # before the relay: bus listeners see the updated stats
	var previous: int = _announced_tier
	_announced_tier = tier
	Events.lucidity_tier_changed.emit(tier, previous)
	Audio.play_sfx(TIER_DOWN_SOUND if tier > previous else TIER_UP_SOUND)
	Log.info("lucidity", "tier %d -> %d value=%d" % [previous, tier, lucidity.value])


## Relays the room's aggravation on the bus (the room listens to the gauge itself).
func _on_lucidity_room_danger_raised(tier: Lucidity.Tier, previous: Lucidity.Tier) -> void:
	Events.room_danger_raised.emit(tier, previous)
	Log.info("lucidity", "room tier %d -> %d" % [previous, tier])


## Relays a spend on the bus (telemetry) and in the log.
func _on_lucidity_spent(power: StringName, cost: int, tier_before: Lucidity.Tier) -> void:
	Events.lucidity_spent.emit(power, cost, tier_before)
	Log.info("lucidity", "spend %s cost=%d tier=%d value=%d" % [power, cost, tier_before, lucidity.value])


## Death is handled here, after player_hit, not on Health.died (emitted inside apply_damage()).
func _on_hurtbox_damage_received(info: DamageInfo) -> void:
	if health.is_dead() or health.is_invulnerable():
		hurtbox.refuse_hit() # not a hit: no item may charge on it
		return
	if is_finite(info.amount) and roundi(info.amount) >= 1: # an invalid amount goes to Health, which reports it
		carrier.hit_incoming.emit(info) # an item may change info.amount
		if is_finite(info.amount) and roundi(info.amount) < 1:
			hurtbox.refuse_hit() # an item took the hit away: refused cleanly, never an invalid amount for Health
			return
	var lost: int = health.apply_damage(info)
	if lost <= 0:
		hurtbox.refuse_hit() # no "hit applied" for a refused hit (story 2.3)
		return
	Events.player_hit.emit(lost, info.source)
	carrier.hit_taken.emit(lost, info.source)
	Audio.play_sfx(HIT_SOUND)
	Log.debug("combat", "player hit lost=%d hearts=%d armor=%d source=%d" % [
		lost, health.half_hearts, health.armor, info.source])
	if health.is_dead():
		_die(info.source)


## The player stops (even if nobody freezes the game), its sprite disappears, then the Run is told.
func _die(source: int) -> void:
	if _death_handled:
		return
	_death_handled = true
	set_physics_process(false)
	velocity = Vector2.ZERO
	_sprite.visible = false
	Log.debug("combat", "player died source=%d" % source) # the INFO line of the death is the Run's
	died.emit()


## Blinks the sprite (visible, never modulate: the dash tint; never the node: the reticle) during the
## invulnerability that follows a hit. Derived from the ticks left: frozen by the pause, slowed by F4.
## Writes visible only while blinking and once when the blink ends: a sprite hidden elsewhere stays hidden.
func _update_blink() -> void:
	if not health.is_hit_invulnerable():
		if _blinking:
			_blinking = false
			_sprite.visible = true # the blink just ended: show the sprite once, never every tick
		return
	_blinking = true
	var elapsed: float = health.hit_ticks_total() - health.hit_ticks_left()
	_sprite.visible = int(elapsed / BLINK_HALF_PERIOD_TICKS) % 2 == 1


func _on_dash_ended() -> void:
	dash_ended.emit()
	carrier.dash_ended.emit()


## Placeholder: a filled 4x4 disc in the color reserved for the player's shots.
func _make_shot_texture() -> Texture2D:
	var image: Image = Image.create(SHOT_TEXTURE_SIZE, SHOT_TEXTURE_SIZE, false, Image.FORMAT_RGBA8)
	var color: Color = Color(Const.COLOR_PLAYER_SHOT, SHOT_ALPHA)
	var center: Vector2 = Vector2.ONE * SHOT_TEXTURE_SIZE / 2.0
	var radius_sq: float = center.x * center.x
	for y: int in SHOT_TEXTURE_SIZE:
		for x: int in SHOT_TEXTURE_SIZE:
			if (Vector2(x, y) + Vector2(0.5, 0.5)).distance_squared_to(center) <= radius_sq:
				image.set_pixel(x, y, color)
	return ImageTexture.create_from_image(image)


func _make_sprite_texture() -> Texture2D:
	var image: Image = Image.create(SPRITE_SIZE.x, SPRITE_SIZE.y, false, Image.FORMAT_RGBA8)
	image.fill(SPRITE_FILL_COLOR)
	for x: int in SPRITE_SIZE.x:
		image.set_pixel(x, 0, SPRITE_RIM_COLOR)
		image.set_pixel(x, SPRITE_SIZE.y - 1, SPRITE_RIM_COLOR)
	for y: int in SPRITE_SIZE.y:
		image.set_pixel(0, y, SPRITE_RIM_COLOR)
		image.set_pixel(SPRITE_SIZE.x - 1, y, SPRITE_RIM_COLOR)
	return ImageTexture.create_from_image(image)


## Builds the stat block from the base tunings and puts on the modifiers of the starting tier.
func _setup_stats() -> void:
	stats = StatBlock.new()
	stats.set_base(StatBlock.Stat.DAMAGE, Tuning.SHOT.damage)
	stats.set_base(StatBlock.Stat.SHOT_SPEED, Tuning.SHOT.bullet_speed)
	stats.set_base(StatBlock.Stat.HURTBOX_SIZE, Tuning.PLAYER.hitbox_size)
	stats.set_base(StatBlock.Stat.PIT_DAMAGE, Tuning.COMBAT.pit_damage_half_hearts)
	stats.set_base(StatBlock.Stat.CAN_FLY_OVER_PITS, 0.0)
	stats.set_base(StatBlock.Stat.MOVE_SPEED, Tuning.PLAYER.move_speed)
	stats.set_base(StatBlock.Stat.FIRE_RATE, Tuning.SHOT.fire_rate)
	stats.set_base(StatBlock.Stat.PIERCE, 0.0)
	stats.set_base(StatBlock.Stat.REAR_SHOT, 0.0)
	# Limits no stack of items may cross (story 5.1).
	stats.set_bounds(StatBlock.Stat.SHOT_SPEED, MIN_SHOT_SPEED, MAX_SHOT_SPEED)
	stats.set_bounds(StatBlock.Stat.HURTBOX_SIZE, MIN_HURTBOX_SIZE, INF)
	stats.set_bounds(StatBlock.Stat.DAMAGE, MIN_DAMAGE, INF)
	stats.set_bounds(StatBlock.Stat.MOVE_SPEED, MIN_MOVE_SPEED, INF)
	stats.set_bounds(StatBlock.Stat.FIRE_RATE, MIN_FIRE_RATE, INF)
	stats.changed.connect(_on_stat_changed)
	stats.base_changed.connect(_on_stat_base_changed)
	_apply_tier_modifiers(lucidity.live_tier)


## One source (the gauge) owns every tier modifier: set_modifier replaces the previous tier's, nothing stacks.
func _apply_tier_modifiers(tier: Lucidity.Tier) -> void:
	var tuning: LucidityTuning = Tuning.LUCIDITY
	var bonus: float = tuning.tier_damage_bonus[tier] if tier < tuning.tier_damage_bonus.size() else 0.0
	stats.set_modifier(lucidity, StatBlock.Stat.DAMAGE, StatBlock.Kind.ADD_PERCENT, bonus)
	var lucid: bool = tier == Lucidity.Tier.LUCID
	stats.set_modifier(lucidity, StatBlock.Stat.SHOT_SPEED, StatBlock.Kind.ADD_PERCENT, tuning.lucid_shot_speed_bonus if lucid else 0.0)
	# 4 px is an absolute value: a replacement through ADD_FLAT, not a percentage
	var shrink: float = tuning.lucid_hurtbox_size - stats.base_of(StatBlock.Stat.HURTBOX_SIZE)
	stats.set_modifier(lucidity, StatBlock.Stat.HURTBOX_SIZE, StatBlock.Kind.ADD_FLAT, shrink if lucid else 0.0)


## Pushes a changed stat into what uses it. Bullets already in flight keep their own speed and damage.
func _on_stat_changed(stat: int) -> void:
	match stat:
		StatBlock.Stat.HURTBOX_SIZE:
			if _hurtbox_shape != null:
				_hurtbox_shape.size = Vector2.ONE * stats.value_of(StatBlock.Stat.HURTBOX_SIZE) * Const.TILE_SIZE
		StatBlock.Stat.SHOT_SPEED:
			if _shot_params != null:
				_shot_params.speed = stats.value_of(StatBlock.Stat.SHOT_SPEED)
		StatBlock.Stat.DAMAGE:
			if _shot_params != null:
				_shot_params.damage = stats.value_of(StatBlock.Stat.DAMAGE)
		StatBlock.Stat.PIERCE:
			if _shot_params != null:
				_shot_params.pierce = stats.value_of(StatBlock.Stat.PIERCE) > 0.0
		StatBlock.Stat.MOVE_SPEED:
			_motor.set_max_speed(stats.value_of(StatBlock.Stat.MOVE_SPEED))
		StatBlock.Stat.FIRE_RATE:
			if _shooter != null:
				_shooter.set_fire_rate(stats.value_of(StatBlock.Stat.FIRE_RATE))


## The Lucid hurtbox is an absolute size: when the base changes, the shrink that gets there is computed again.
func _on_stat_base_changed(stat: int) -> void:
	if stat == StatBlock.Stat.HURTBOX_SIZE and lucidity != null:
		_apply_tier_modifiers(lucidity.live_tier)


## The build (story 5.1): created once stats exist; the items change the hearts through it.
func _setup_carrier() -> void:
	carrier = BuildCarrier.new()
	carrier.name = "BuildCarrier"
	carrier.setup(self, stats)
	add_child(carrier)
	carrier.loadout.item_added.connect(_on_item_added)
	carrier.loadout.item_removed.connect(_on_item_removed)


## A price paid in hearts: the max goes down now (the current hearts come down with it).
func _on_item_added(owned: OwnedItem) -> void:
	if owned.def.max_half_hearts_delta < 0:
		owned.max_half_hearts_paid = health.lose_max(-owned.def.max_half_hearts_delta)


func _on_item_removed(owned: OwnedItem) -> void:
	if owned.max_half_hearts_paid > 0:
		health.restore_max(owned.max_half_hearts_paid)
