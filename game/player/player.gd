class_name Player
extends CharacterBody2D
## The player. Node origin = center of the torso: shots start from there.
## Movement, aim and shots read the InputMap in _physics_process and obey GameClock.
## Shots need a BulletManager given by the room through equip_bullets().

## Emitted when a dash finishes, after its last movement.
signal dash_ended
## Emitted once, when the player dies: after the Events.player_hit of the lethal hit.
## The Run is its only listener: it emits Events.run_ended inside this emission, so any other listener of died
## runs after run_ended and after Main froze the game; cross-system listeners use Events.run_ended.
signal died

## Placeholder sprite size in pixels (structural, not gameplay). Real sprites come with epic 7.
const SPRITE_SIZE: Vector2i = Vector2i(16, 24)
# Placeholder colors until epic 7.
const SPRITE_FILL_COLOR: Color = Color(0.45, 0.65, 0.95)
const SPRITE_RIM_COLOR: Color = Color(0.75, 0.88, 1.0)
# Placeholder tint while the dash makes the player invulnerable, until epic 7.
const DASH_TINT: Color = Color(1.0, 1.0, 1.0, 0.5)
## Placeholder shot texture, same size as the 4x4 px hitbox (enemy placeholder bullets are 8x8), until story 7.2.
const SHOT_TEXTURE_SIZE: int = 4
## Placeholder shot opacity: more transparent than enemy bullets (NFR8), until story 7.2.
const SHOT_ALPHA: float = 0.7
## Placeholder shot sound, generated by a script; replaced by story 7.7.
const SHOT_SOUND: AudioStream = preload("res://audio/sfx/sfx_player_shot.wav")

## Placeholder hit sound, generated by a script; replaced by story 7.7.
const HIT_SOUND: AudioStream = preload("res://audio/sfx/sfx_player_hit.wav")
## Placeholder tier sounds (story 3.1), generated by a script; replaced by story 7.7.
const TIER_DOWN_SOUND: AudioStream = preload("res://audio/sfx/sfx_lucidity_tier_down.wav")
const TIER_UP_SOUND: AudioStream = preload("res://audio/sfx/sfx_lucidity_tier_up.wav")
## Placeholder graze and perfect dash sounds (story 3.2), generated by a script; replaced by story 7.7.
const GRAZE_SOUND: AudioStream = preload("res://audio/sfx/sfx_graze.wav")
const PERFECT_DASH_SOUND: AudioStream = preload("res://audio/sfx/sfx_perfect_dash.wav")
## A wall of bullets must not saturate the audio: graze voices at once.
const GRAZE_MAX_VOICES: int = 2
## Half period of the blink after a hit, in game ticks (0.1 s at 60 Hz). Visual placeholder until epic 7: small
## surface, no full-screen flash (photosensitivity settings: FR67, epic 3).
const BLINK_HALF_PERIOD_TICKS: int = 6

## Hearts, armor and invulnerability after a hit. Created in code (setup() before add_child()).
var health: Health
## The lucidity gauge (story 3.1), full at the start of a run. Created in code like health.
var lucidity: Lucidity
## The zone enemy bullets hit. The room registers it with the enemy BulletManager.
var hurtbox: Hurtbox

var _motor: PlayerMotor
var _dash: Dash
## Last movement direction (unit vector). The character faces the camera until the player first moves.
var _facing: Vector2 = Vector2.DOWN
var _aim: Aim
var _shooter: Shooter
var _recoil: SpriteKick
var _bullets: BulletManager
## Own copy built once from Tuning.SHOT by equip_bullets(), never a shared Resource.
var _shot_params: BulletParams
## Viewport mouse position on the previous tick: the mouse takes the aim back only when it moves.
var _last_mouse_pos: Vector2 = Vector2.ZERO
var _unequipped_reported: bool = false
var _death_handled: bool = false
## Last tier put on the bus (the tier before a change).
var _announced_tier: int = 0
## True while the sprite blinks after a hit: visible is written on blink transitions only.
var _blinking: bool = false

@onready var _sprite: Sprite2D = %Sprite
@onready var _hitbox: CollisionShape2D = %Hitbox


func _ready() -> void:
	motion_mode = CharacterBody2D.MOTION_MODE_FLOATING
	collision_layer = Const.LAYER_PLAYER
	collision_mask = Const.LAYER_WALLS | Const.LAYER_ENEMIES # the dash and the walk stop on enemy bodies (FR4)
	_motor = PlayerMotor.new(Tuning.PLAYER)
	_dash = Dash.new(Tuning.DASH)
	_dash.ended.connect(_on_dash_ended)

	_sprite.centered = true
	_sprite.offset = Vector2.ZERO
	_sprite.texture = _make_sprite_texture()

	# A fresh shape per instance: never modify a sub-resource shared by the scene.
	var shape: RectangleShape2D = RectangleShape2D.new()
	shape.size = Vector2.ONE * Tuning.PLAYER.hitbox_size * Const.TILE_SIZE
	_hitbox.shape = shape
	_hitbox.position = Vector2.ZERO
	_hitbox.add_to_group(Const.GROUP_DEBUG_SHAPES)

	_setup_health()
	_setup_lucidity()
	Events.room_cleared.connect(_on_room_cleared)

	_aim = Aim.new()
	_shooter = Shooter.new(Tuning.SHOT)
	_recoil = SpriteKick.new(_sprite)
	_last_mouse_pos = get_viewport().get_mouse_position()
	var reticle: Reticle = Reticle.new()
	reticle.setup(self)
	add_child(reticle)


func _setup_health() -> void:
	add_to_group(Const.GROUP_PLAYER)
	health = Health.new()
	health.name = "Health"
	var combat: CombatTuning = Tuning.COMBAT
	health.setup(
		combat.starting_half_hearts,
		combat.heart_cap_half_hearts,
		combat.hit_invulnerability_duration,
		GameClock.Group.PLAYER
	)
	add_child(health)
	health.changed.connect(_on_health_changed)
	_on_health_changed() # initial state for the HUD

	hurtbox = Hurtbox.new()
	hurtbox.name = "Hurtbox"
	hurtbox.camp = BulletManager.Camp.PLAYER
	hurtbox.one_hit_per_tick = true
	var shape_node: CollisionShape2D = CollisionShape2D.new()
	shape_node.name = "Shape"
	var shape: RectangleShape2D = RectangleShape2D.new()
	shape.size = Vector2.ONE * Tuning.PLAYER.hitbox_size * Const.TILE_SIZE
	shape_node.shape = shape
	hurtbox.add_child(shape_node) # before add_child(hurtbox): its _ready() looks for the shape
	add_child(hurtbox)
	hurtbox.set_hit_filter(_can_be_hit)
	hurtbox.set_evade_filter(is_dash_invulnerable)
	hurtbox.damage_received.connect(_on_hurtbox_damage_received)


## Called by the room once it has built its BulletManager (the player is already ready by then).
func equip_bullets(manager: BulletManager) -> void:
	if manager == null:
		Log.error("combat", "equip_bullets() called without a BulletManager")
		assert(false, "equip_bullets() needs a BulletManager")
		return
	var tuning: ShotTuning = Tuning.SHOT
	_bullets = manager
	_shot_params = BulletParams.new()
	_shot_params.speed = tuning.bullet_speed
	_shot_params.radius = maxf(tuning.hitbox_size, 0.0) / 2.0
	_shot_params.lifetime = tuning.lifetime
	_shot_params.damage = maxf(tuning.damage, 0.0)
	_shot_params.appearance = manager.add_appearance(_make_shot_texture())


func _physics_process(delta: float) -> void:
	var clock_scale: float = GameClock.scale(GameClock.Group.PLAYER)
	var wish: Vector2 = Input.get_vector(&"move_left", &"move_right", &"move_up", &"move_down")
	if wish != Vector2.ZERO:
		_facing = wish.normalized()
	# The motor runs on the real delta so the ramps and the paused state stay consistent with the input;
	# it keeps stepping during a dash so walking resumes smoothly when the dash ends.
	var motor_velocity: Vector2 = _motor.step(wish, delta)
	_dash.tick(clock_scale, Input.is_action_just_pressed(&"dash"), _facing)
	_update_shooting(clock_scale) # before the movement: sees "is the dash active this tick"
	# velocity is rewritten every tick: move_and_slide() alters it when sliding, never read it back.
	if _dash.is_active():
		# Already scaled by the clock inside Dash: do not multiply by clock_scale again.
		velocity = _dash.velocity(delta)
	else:
		# The clock scale is applied once, on the final velocity (move_and_slide() uses the unscaled delta).
		velocity = motor_velocity * clock_scale
	move_and_slide()
	_dash.finish_tick()  # after the movement: listeners of dash_ended see the final position
	_update_dash_tint()
	_update_blink()


func is_dash_invulnerable() -> bool:
	return _dash.is_invulnerable()


## Dash or post-hit (or forced, debug) invulnerability.
func is_invulnerable() -> bool:
	return is_dash_invulnerable() or health.is_invulnerable()


func is_dashing() -> bool:
	return _dash.is_active()


## Current aim direction (unit vector, never zero).
func aim_direction() -> Vector2:
	return _aim.direction


func aim_source() -> Aim.Source:
	return _aim.source


func _update_shooting(clock_scale: float) -> void:
	var stick: Vector2 = Input.get_vector(&"aim_left", &"aim_right", &"aim_up", &"aim_down")
	var mouse_pos: Vector2 = get_viewport().get_mouse_position()
	var mouse_moved: bool = mouse_pos != _last_mouse_pos
	_last_mouse_pos = mouse_pos
	_aim.update(global_position, get_global_mouse_position(), mouse_moved, stick)
	# Click or RT (shoot), or the right stick beyond its dead zone (auto fire).
	var wants_fire: bool = Input.is_action_pressed(&"shoot") or _aim.is_stick_active()
	# Before the shot: a recoil started on this tick keeps all its ticks (0.05 s = 3 rendered ticks).
	_recoil.tick(clock_scale)
	if _shooter.tick(clock_scale, wants_fire, _dash.is_active()):
		_fire()


## One shot from the center of the torso, exactly along the aim. No recoil or sound if the pool refuses it.
func _fire() -> void:
	if _bullets == null:
		if not _unequipped_reported:
			_unequipped_reported = true
			Log.error("combat", "player cannot shoot: no BulletManager (equip_bullets() not called)")
		return
	if not _bullets.fire(_shot_params, _bullets.to_local(global_position), _aim.direction):
		return
	var tuning: ShotTuning = Tuning.SHOT
	_recoil.kick(-_aim.direction, tuning.recoil_distance * Const.TILE_SIZE, tuning.recoil_duration)
	Audio.play_sfx(SHOT_SOUND)


func _update_dash_tint() -> void:
	_sprite.modulate = DASH_TINT if is_dash_invulnerable() else Color.WHITE


## Hit filter of the hurtbox: bullets pass through while invulnerable or dead.
func _can_be_hit() -> bool:
	return not is_invulnerable() and not health.is_dead()


## Builds the gauge and relays it on the bus: value for the HUD, tier change for sound and telemetry.
func _setup_lucidity() -> void:
	lucidity = Lucidity.new(Tuning.LUCIDITY)
	lucidity.value_changed.connect(_on_lucidity_value_changed)
	lucidity.tier_changed.connect(_on_lucidity_tier_changed)
	_announced_tier = lucidity.live_tier
	_on_lucidity_value_changed(lucidity.value) # initial state for the HUD


## A bullet passed close to the hurtbox without touching it (signal of the enemy BulletManager, story 3.2).
func on_bullet_grazed(bullet_position: Vector2) -> void:
	if health.is_dead():
		return
	var gained: int = lucidity.gain(Tuning.LUCIDITY.graze_gain, Lucidity.Source.GRAZE)
	Events.player_grazed.emit(bullet_position, gained)
	Audio.play_sfx(GRAZE_SOUND, GRAZE_MAX_VOICES)
	Log.debug("lucidity", "graze +%d value=%d" % [gained, lucidity.value])


## The dash invulnerability avoided a bullet that would have hit (once per bullet).
func on_bullet_dodged(bullet_position: Vector2) -> void:
	if health.is_dead():
		return
	var gained: int = lucidity.gain(Tuning.LUCIDITY.perfect_dash_gain, Lucidity.Source.PERFECT_DASH)
	Events.perfect_dash.emit(bullet_position, gained)
	Audio.play_sfx(PERFECT_DASH_SOUND, 1)
	Log.debug("lucidity", "perfect dash +%d value=%d" % [gained, lucidity.value])


## The room has no enemy left: a living player gains lucidity. Extra arguments of the signal (story 3.6) are not read.
func _on_room_cleared(_room: Node) -> void:
	if health.is_dead():
		return
	lucidity.gain(Tuning.LUCIDITY.room_cleared_gain, Lucidity.Source.ROOM_CLEARED)


## Tells the HUD (through the bus: the Run, so the player, is recreated every run).
func _on_health_changed() -> void:
	Events.player_health_changed.emit(health.half_hearts, health.max_half_hearts, health.armor)


func _on_lucidity_value_changed(value: int) -> void:
	Events.lucidity_value_changed.emit(value, lucidity.live_tier)


## Announces a tier change on the bus and by sound (a lower tone down, a rising one up).
func _on_lucidity_tier_changed(tier: Lucidity.Tier) -> void:
	var previous: int = _announced_tier
	_announced_tier = tier
	Events.lucidity_tier_changed.emit(tier, previous)
	Audio.play_sfx(TIER_DOWN_SOUND if tier > previous else TIER_UP_SOUND)
	Log.info("lucidity", "tier %d -> %d value=%d" % [previous, tier, lucidity.value])


## Death is handled here, after player_hit, not on Health.died (emitted inside apply_damage()).
func _on_hurtbox_damage_received(info: DamageInfo) -> void:
	var lost: int = health.apply_damage(info)
	if lost <= 0:
		hurtbox.refuse_hit() # no "hit applied" for a refused hit (story 2.3)
		return
	Events.player_hit.emit(lost, info.source)
	Audio.play_sfx(HIT_SOUND)
	Log.debug("combat", "player hit lost=%d hearts=%d armor=%d source=%d" % [
		lost, health.half_hearts, health.armor, info.source])
	if health.is_dead():
		_die(info.source)


## The player stops (even if nobody freezes the game), its sprite disappears, then the Run is told.
func _die(source: int) -> void:
	if _death_handled:
		return
	_death_handled = true
	set_physics_process(false)
	velocity = Vector2.ZERO
	_sprite.visible = false
	Log.debug("combat", "player died source=%d" % source) # the INFO line of the death is the Run's
	died.emit()


## Blinks the sprite (visible, never modulate: the dash tint; never the node: the reticle) during the
## invulnerability that follows a hit. Derived from the ticks left: frozen by the pause, slowed by F4.
## Writes visible only while blinking and once when the blink ends: a sprite hidden elsewhere stays hidden.
func _update_blink() -> void:
	if not health.is_hit_invulnerable():
		if _blinking:
			_blinking = false
			_sprite.visible = true # the blink just ended: show the sprite once, never every tick
		return
	_blinking = true
	var elapsed: float = health.hit_ticks_total() - health.hit_ticks_left()
	_sprite.visible = int(elapsed / BLINK_HALF_PERIOD_TICKS) % 2 == 1


func _on_dash_ended() -> void:
	dash_ended.emit()


## Placeholder: a filled 4x4 disc in the color reserved for the player's shots.
func _make_shot_texture() -> Texture2D:
	var image: Image = Image.create(SHOT_TEXTURE_SIZE, SHOT_TEXTURE_SIZE, false, Image.FORMAT_RGBA8)
	var color: Color = Color(Const.COLOR_PLAYER_SHOT, SHOT_ALPHA)
	var center: Vector2 = Vector2.ONE * SHOT_TEXTURE_SIZE / 2.0
	var radius_sq: float = center.x * center.x
	for y: int in SHOT_TEXTURE_SIZE:
		for x: int in SHOT_TEXTURE_SIZE:
			if (Vector2(x, y) + Vector2(0.5, 0.5)).distance_squared_to(center) <= radius_sq:
				image.set_pixel(x, y, color)
	return ImageTexture.create_from_image(image)


func _make_sprite_texture() -> Texture2D:
	var image: Image = Image.create(SPRITE_SIZE.x, SPRITE_SIZE.y, false, Image.FORMAT_RGBA8)
	image.fill(SPRITE_FILL_COLOR)
	for x: int in SPRITE_SIZE.x:
		image.set_pixel(x, 0, SPRITE_RIM_COLOR)
		image.set_pixel(x, SPRITE_SIZE.y - 1, SPRITE_RIM_COLOR)
	for y: int in SPRITE_SIZE.y:
		image.set_pixel(0, y, SPRITE_RIM_COLOR)
		image.set_pixel(SPRITE_SIZE.x - 1, y, SPRITE_RIM_COLOR)
	return ImageTexture.create_from_image(image)
