class_name Boss
extends Enemy
## Base of the bosses (AR7, D2): an immobile Enemy driven by its BossDef. It announces its phase on the blackboard
## (ANNOUNCING, the Telegraph node counts it), then fights (FIGHTING): the attacks of the current phase run through
## AttackRunners that the boss ticks. The phase follows the share of hit points left. Spawned like any enemy, by a room
## (the wave of its EnemySpawn marker); the room binds it to itself before it enters the tree (bind_room()).
## Bullets go through the room's enemy BulletManager with the reserved look; nothing fires outside the playable area.
## Subclasses (Professor) are puppets: sprite and scene, the logic stays here. 6.4 adds DEFEATED to State.

enum State { ANNOUNCING, FIGHTING }

## Placeholder announce sound, generated by a script; replaced by story 7.7.
const ANNOUNCE_SOUND: AudioStream = preload("res://audio/sfx/sfx_enemy_night_light_telegraph.wav")
const SHARE_EPSILON: float = 1e-6
const TICK_EPSILON: float = 1e-6

var _state: State = State.ANNOUNCING
var _boss_def: BossDef
var _room: Room
var _run_rng: RunRng
var _floor_index: int = 0
var _bullet_params: BulletParams
var _phase_index: int = 0
var _runners: Array[AttackRunner] = []
## Group of attacks each runner belongs to (-1: an extra of the phase), same order as _runners.
var _runner_groups: Array[int] = []
## The group that runs while the phase alternates, and the ticks left before the next one takes over.
var _active_group: int = 0
var _alternate_ticks_left: float = 0.0
## False until the first FIGHTING: the opening announce is the one of phase 0, whatever the hit points.
var _fight_started: bool = false
## True once the run is over or the boss is dead: no attack starts any more.
var _halted: bool = false
var _left_tree_reported: bool = false


## Before add_child() (Room.spawn_enemy()): the room, its streams and the floor.
func bind_room(room: Room, run_rng: RunRng, floor_index: int) -> void:
	_room = room
	_run_rng = run_rng
	_floor_index = floor_index


func _ready() -> void:
	super()
	if _def == null:
		return # already reported by Enemy
	_boss_def = _def as BossDef
	if _boss_def == null or _bullets == null or _room == null or _run_rng == null or _boss_def.phases.is_empty():
		process_mode = Node.PROCESS_MODE_DISABLED # before the assert: it aborts the function in debug builds
		_def = null # subclasses test _def after super()
		Log.error("combat", "boss %s needs a BossDef with phases, a room, its streams and the enemy BulletManager" % get_path())
		assert(false, "Boss needs a BossDef, bind_room() and a BulletManager")
		return
	_bullet_params = BulletParams.new() # own instance, never a shared Resource
	_bullet_params.speed = 1.0
	_bullet_params.radius = Tuning.COMBAT.enemy_bullet_radius
	_bullet_params.lifetime = Tuning.COMBAT.enemy_bullet_lifetime
	_bullet_params.damage = Tuning.COMBAT.hit_damage_half_hearts
	_bullet_params.appearance = _bullets.add_appearance(EnemyBulletLook.texture()) # the same index for every enemy
	if _bullet_params.appearance < 0:
		_halted = true # fire() would refuse every bullet
		Log.error("combat", "boss %s got no bullet appearance, it never attacks" % _boss_def.id)
		_assert_failed("Boss needs a bullet appearance")
	Events.run_ended.connect(_on_events_run_ended)
	Events.boss_engaged.emit(_boss_def.id, hp.maximum)
	Events.boss_health_changed.emit(hp.current, hp.maximum)
	_enter(State.ANNOUNCING)


func _physics_process(_delta: float) -> void:
	if _def == null or _dead:
		return
	var clock_scale: float = GameClock.scale(GameClock.Group.ENEMIES) # one read per tick
	if clock_scale <= 0.0:
		return
	match _state:
		State.ANNOUNCING:
			if not telegraph.is_active():
				_enter(State.FIGHTING)
		State.FIGHTING:
			_process_fighting(clock_scale)


func _process_fighting(clock_scale: float) -> void:
	if _halted or danger.fire_hold:
		return # the room holds the fire (story 5.9): everything is frozen, signs included
	_tick_alternation(clock_scale)
	for runner: AttackRunner in _runners:
		runner.tick(clock_scale, danger.pace_mult)


## The only place that writes _state.
func _enter(next: State) -> void:
	_state = next
	match next:
		State.ANNOUNCING:
			var title_key: StringName = _boss_def.phases[_phase_index].title_key
			telegraph.start(_boss_def.announce_duration, ANNOUNCE_SOUND) # the room's danger never shortens an announce
			Events.boss_announced.emit(_boss_def.id, title_key)
		State.FIGHTING:
			if _fight_started:
				_start_phase(_boss_def.phases[_phase_index]) # the title is written: the phase of the announce begins
			else:
				_fight_started = true
				_phase_index = -1
				_update_phase()


func current_phase_index() -> int:
	return _phase_index


func is_fighting() -> bool:
	return _state == State.FIGHTING


func runners() -> Array[AttackRunner]:
	return _runners


## One draw, 0 to 1, of the BOSS stream of the run for this floor: the only random source of the boss.
func draw_unit() -> float:
	return _run_rng.stream(RunRng.BOSS, _floor_index).randf()


## The player's hurtbox: what the contact zones of the boss (the ruler) hit.
func target_hurtbox() -> Hurtbox:
	return _target_hurtbox


## The boss, in room pixels.
func room_position() -> Vector2:
	return _room.to_local(global_position)


## The player (what the boss aims at), in room pixels.
func target_room_position() -> Vector2:
	return _room.to_local(_target.global_position)


## The playable area of the room, in room pixels.
func arena_px() -> Rect2:
	return Rect2(Vector2.ONE * Const.TILE_SIZE, Vector2(_room.playable_tiles() * Const.TILE_SIZE))


## Puts a sign under the room, above the decor.
func add_sign(sign_node: Node2D) -> void:
	_room.add_child(sign_node)


## Fires one bullet of the boss. origin: room pixels, inside the playable area (else refused); speed_tiles: tiles per
## second, the room's danger already applied. False when refused (outside, walled in, pool full).
func fire_bullet(origin: Vector2, direction: Vector2, speed_tiles: float) -> bool:
	if _halted or not arena_px().has_point(origin):
		return false
	_bullet_params.speed = speed_tiles
	return _bullets.fire(_bullet_params, _bullets.to_local(_room.to_global(origin)), direction)


## The share of hit points left, 0 to 1.
func hp_share() -> float:
	return hp.current / hp.maximum


## Debug (F1) and tests: puts the hit points at this share of the maximum (not 0: use kill()), as a hit would.
func debug_set_hp_fraction(share: float) -> void:
	if _dead or not is_finite(share):
		return
	hp.current = clampf(share, 0.001, 1.0) * hp.maximum
	_on_hit_applied()


## Immobile and never dazzled: an announce cancelled in the middle of a phase would leave the blackboard lying.
func dazzle(_seconds: float) -> void:
	pass


func knock_back(_direction: Vector2, _distance_px: float) -> float:
	return 0.0


func _on_hit_applied() -> void:
	Events.boss_health_changed.emit(hp.current, hp.maximum)
	if _fight_started and not hp.is_dead() and not _halted:
		_change_phase_if_crossed()


func _on_death() -> void:
	_halt()
	_report_left()


func _exit_tree() -> void:
	_halt()
	_report_left()


## Phase of the current share of hit points: the last one whose threshold is reached.
func _phase_for_share() -> int:
	var share: float = hp_share()
	var index: int = 0
	for i: int in _boss_def.phases.size():
		if share <= _boss_def.phases[i].hp_from + SHARE_EPSILON:
			index = i
	return index


## First phase of the fight: starts its attacks at once (its title was written by the opening announce).
func _update_phase() -> void:
	var index: int = _phase_for_share()
	if index == _phase_index:
		return
	_phase_index = index
	_stop_runners()
	if not _halted:
		_start_phase(_boss_def.phases[index])
	Events.boss_phase_changed.emit(_boss_def.id, index)


## A hit crossed a threshold (or several): straight to the phase of the hit points left, one announce, the attacks held
## until the title is written. The chalks already fired go on (Decision 5: the phases jumped over are not announced).
func _change_phase_if_crossed() -> void:
	var index: int = _phase_for_share()
	if index == _phase_index:
		return
	_phase_index = index
	_stop_runners()
	Events.boss_phase_changed.emit(_boss_def.id, index)
	_enter(State.ANNOUNCING)


func _start_phase(phase: BossPhase) -> void:
	if _halted:
		return
	_active_group = 0
	_alternate_ticks_left = phase.alternate_seconds * Engine.physics_ticks_per_second
	if phase.alternates():
		_start_attacks(phase.group_attacks(0), 0)
	else:
		for i: int in phase.groups.size():
			_start_attacks(phase.group_attacks(i), i)
	_start_attacks(phase.extras, -1)


## The groups of an alternating phase take turns: the one that leaves stops its runners (their chalks go on).
func _tick_alternation(clock_scale: float) -> void:
	var phase: BossPhase = _boss_def.phases[_phase_index]
	if not phase.alternates():
		return
	_alternate_ticks_left -= clock_scale
	if _alternate_ticks_left > TICK_EPSILON:
		return
	_alternate_ticks_left += phase.alternate_seconds * Engine.physics_ticks_per_second
	var next: int = (_active_group + 1) % phase.groups.size()
	for i: int in range(_runners.size() - 1, -1, -1):
		if _runner_groups[i] == _active_group:
			_runners[i].stop()
			_runners.remove_at(i)
			_runner_groups.remove_at(i)
	_active_group = next
	_start_attacks(phase.group_attacks(next), next)


func _start_attacks(attacks: Array[BossAttack], group: int) -> void:
	for attack: BossAttack in attacks:
		var problem: String = attack.validate()
		if problem.is_empty() and attack.kind == BossAttack.Kind.ROW and attack.gap_tiles >= arena_px().size.x / Const.TILE_SIZE:
			problem = "gap_tiles %s does not fit in the room" % attack.gap_tiles
		if not problem.is_empty():
			Log.error("combat", "boss %s attack skipped: %s" % [_boss_def.id, problem])
			_assert_failed("BossAttack is invalid: %s" % problem)
			continue
		var runner: AttackRunner = AttackRunner.make(attack)
		if runner == null:
			continue
		runner.setup(self, attack)
		_runners.append(runner)
		_runner_groups.append(group)


func _stop_runners() -> void:
	for runner: AttackRunner in _runners:
		runner.stop()
	_runners.clear()
	_runner_groups.clear()


## No attack starts or appears any more.
func _halt() -> void:
	_halted = true
	_stop_runners()


func _on_events_run_ended(_outcome: int) -> void:
	_halt()


## The health bar hides at 0, whatever took the boss out of the room (death, room torn down). Once.
func _report_left() -> void:
	if _left_tree_reported or _boss_def == null:
		return
	_left_tree_reported = true
	Events.boss_health_changed.emit(0.0, hp.maximum if hp != null else 1.0)
